# Current scripted baseline.
#
# These values are what the live build and packaging scripts use today. The
# previous 2.52.1 line is still available by override, but the default engine
# line is now 2.52.4. As of the official 5.1.0.11 release, the SFOS SDK target
# archive is public, so the CI/bootstrap path downloads the sysroot directly
# from https://releases.sailfishos.org/sdk/targets/ (no local seed needed).

SFOS_SYSROOT_VERSION=5.1.0.11

LIBWPE_VERSION=1.17.0
LIBEPOXY_VERSION=1.5.11
WPEBACKEND_FDO_VERSION=1.17.0
# libavif for AVIF image decoding (USE_AVIF). Built from source decode-only
# (dav1d backend) so the device lib only needs libdav1d — see build-engine.sh [8].
LIBAVIF_VERSION=v1.0.4

LEGACY_WPEWEBKIT_VERSION=2.52.4
LEGACY_QT5_PLUGIN_SOURCE_VERSION=2.52.1

WPE_SFOS_COMPAT_VERSION=1.0.0
# Beta versioning: "1.0.0.beta1" (dot, not the RPM-conventional tilde) so it
# rpmvercmp-sorts ABOVE the 1.0.0-<ci-run> dev builds already on devices —
# `zypper up` keeps working. The final release must therefore be >= 1.0.1.
ATLANTIC_BROWSER_VERSION=1.0.0.beta5

# Engine migration target.
TARGET_SFOS_VERSION=5.1.0.11
TARGET_WPEWEBKIT_VERSION=2.52.4

# SFOS 5.1 compatibility defaults.
# The updated target root on this host provides newer glibc and GLib than the
# Ubuntu 24.04 build host, so the normal path no longer needs GLIBC retagging or
# the old glibc/GLib preload shims. Keep the remaining uncertain shims explicit
# so they can be re-checked independently as the runtime is exercised.
PATCH_GLIBC_VERSIONS=0
# USE_GLIBC_COMPAT=0 since the SFOS 5.1 line: the device/sysroot glibc is 2.41,
# which natively provides every symbol the shim backfilled (arc4random,
# __libc_single_threaded, stat/fstat/lstat@GLIBC_2.33, dlopen@GLIBC_2.34,
# __isoc23_*, strlcpy, _dl_find_object — verified against the 5.1 sysroot),
# and every binary we ship needs at most GLIBC_2.38 (bundled libsoup3).
# Keeping the shim was not free: it LD_PRELOAD-interposed the whole stat()
# family into the browser, WPEWebProcess and WPENetworkProcess with a bug that
# turned every stat failure into EPERM instead of ENOENT (now fixed in
# shims/compat/libglibc-compat.c), confusing existence checks in sqlite,
# fontconfig, GIO and the WebKit caches. Re-enable only for a target older
# than glibc 2.39.
USE_GLIBC_COMPAT=0
USE_GLIB_COMPAT=0
USE_COW_STRING_COMPAT=0
USE_SIGILL_SKIP=1
USE_EGL_STUBS=1
# Preload libsyncskip.so (skip the hybris eglSwapBuffers sync-fence CPU wait on
# the compositor render threads). The shim itself stays inert unless
# ATLANTIC_SKIP_SWAP_FENCE=1 at runtime — device-verified 13→24fps on YouTube
# 1080p, opt-in until broadly validated (suspected of one hard crash).
USE_SYNC_FENCE_SKIP=1

# The WPE build now enables the bubblewrap sandbox again
# (ENABLE_BUBBLEWRAP_SANDBOX=ON in cmake/atlantic-wpe-features.cmake).  At
# runtime it stays OFF unless ATLANTIC_ENABLE_SANDBOX=1 (see
# deploy/runtime-common.sh).  bwrap and xdg-dbus-proxy are the device-side
# executables libWPEWebKit exec's when the sandbox is enabled; scripts/build-sandbox-deps.sh
# builds them and build-rpms-native.sh packages them as the bubblewrap /
# xdg-dbus-proxy RPMs (atlantic-browser Requires both).
BUBBLEWRAP_VERSION=0.11.0
XDG_DBUS_PROXY_VERSION=0.1.6

# Content-blocker (EasyList / EasyPrivacy) sources.
# These lists are NO LONGER vendored in git (they were 145k lines, ~85% of the
# repo, and went stale). build-rpms-native.sh fetches them at build time into
# data/content-blocker/ (gitignored), mirroring how bwrap/xdg-dbus-proxy are
# downloaded. easylist-to-webkit.py then compiles them into content-blocker.json.
#
# Reproducibility: EasyList publishes no dated URL for the combined files, so by
# default the latest snapshot is fetched. For locked builds, set the SHA256 pins
# below and CONTENT_BLOCKER_STRICT=1 (a self-hosted mirror is then recommended).
# Last snapshot that was vendored: Version 202605281837 (2026-05-28)
#   easylist.txt    sha256 350cf87cbdb3e35678ed1ddf236d0a32c7d8857b6a583c484b6476ca3c0c4442
#   easyprivacy.txt sha256 21458d0786025ced5cd03faad69bd6e0df320ef210b67814bb8e7c2f816c39a4
EASYLIST_URL=https://easylist.to/easylist/easylist.txt
EASYPRIVACY_URL=https://easylist.to/easylist/easyprivacy.txt
EASYLIST_SHA256=
EASYPRIVACY_SHA256=
CONTENT_BLOCKER_STRICT=0

# Adblock engine filter lists (Fanboy's Annoyance + uBO Annoyances)
FANBOY_ANNOYANCE_URL=https://secure.fanboy.co.nz/fanboy-annoyance.txt
UBO_ANNOYANCES_URL=https://raw.githubusercontent.com/uBlockOrigin/uAssets/master/filters/annoyances.txt
FANBOY_ANNOYANCE_SHA256=
UBO_ANNOYANCES_SHA256=

# Adblock engine filter lists (social widgets + anti-circumvention)
FANBOY_SOCIAL_URL=https://secure.fanboy.co.nz/fanboy-social.txt
ANTI_CV_URL=https://gitlab.com/eyeo/anti-cv/abp-filters-anti-cv/-/raw/master/distribution/abp-filters-core.txt
FANBOY_SOCIAL_SHA256=
ANTI_CV_SHA256=

# Regional Anti-CV language lists
ANTI_CV_REPO_RAW=https://gitlab.com/eyeo/anti-cv/abp-filters-anti-cv/-/raw/master
REGIONAL_ANTI_CV_LISTS="arabic bulgarian chinese czech dutch english french german hebrew hungarian indian indonesian italian latvian lithuanian nordic polish portuguese romanian russian spanish tamil turkish vietnamese"

# Adblock engine filter lists (cookie / GDPR consent)
FANBOY_COOKIE_URL=https://secure.fanboy.co.nz/fanboy-cookiemonster.txt
FANBOY_COOKIE_SHA256=
# uBO's dedicated cookie-notice list (NOT part of annoyances.txt). Mostly
# hide rules plus trusted-click-element scriptlets; the hides still help even
# where the scriptlet is unsupported.
UBO_COOKIES_URL=https://raw.githubusercontent.com/uBlockOrigin/uAssets/master/filters/annoyances-cookies.txt
UBO_COOKIES_SHA256=

# DuckDuckGo autoconsent: CMP auto-reject engine (MPL-2.0), injected by the
# browser as a document-start user script. Fetched as an npm tarball; the
# build extracts dist/autoconsent.playwright.js + rules/rules.json.
AUTOCONSENT_VERSION=16.10.0
AUTOCONSENT_URL=https://registry.npmjs.org/@duckduckgo/autoconsent/-/autoconsent-16.10.0.tgz
AUTOCONSENT_SHA256=f6f0df3fc9478bbf5d1bf65a8e46aeab29cd19e0618805f6fdd09f22e5621d69

# Adblock runtime resources: Brave's dist bundle only carries their redirect
# surrogates; the ##+js(...) scriptlet bodies come from uBO's scriptlets.js,
# pinned to the last OLD-format revision (pre-ES-module, commit 56b82011 of
# 2023-03-24) — the only format adblock-rust's resource assembler can parse.
# The builder --resources mode merges both into adblock-resources.json.
ADBLOCK_RESOURCES_URL=https://raw.githubusercontent.com/brave/adblock-resources/master/dist/resources.json
ADBLOCK_RESOURCES_SHA256=
UBO_SCRIPTLETS_URL=https://raw.githubusercontent.com/gorhill/uBlock/56b8201196a02e4d6c31bce7c168ad1c961ed63e/assets/resources/scriptlets.js
UBO_SCRIPTLETS_SHA256=
