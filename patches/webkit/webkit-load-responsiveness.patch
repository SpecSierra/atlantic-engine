# Input and scrolling during a heavy page load.
# Merged from: webkit-loading-timer-alignment-env, webkit-parser-time-limit-env,
# webkit-touch-ack-timeout-env.
#
# During a heavy load the WebProcess main thread is saturated and queued touch
# events starve, so the page cannot scroll until the load event fires. These
# shrink main-thread task granularity during load and stop dropping late touch
# replies:
#  - align maximally-nested DOM timers to a 50 ms grid while the top document is
#    loading (WEBKIT_LOADING_TIMER_ALIGNMENT_MS);
#  - yield the HTML parser every 100 ms instead of 500 ms
#    (WEBKIT_PARSER_TIME_LIMIT_MS);
#  - UIProcess-side gesture recognition when the WebProcess does not ack touch
#    events in time, plus stop dropping late-reply gesture events
#    (WEBKIT_TOUCH_ACK_TIMEOUT_MS, ships 100). This is the one that makes
#    scrolling work DURING load.
#
# ---
diff -ruN --no-dereference sq-A/Source/WebCore/dom/Document.cpp sq-B/Source/WebCore/dom/Document.cpp
--- a/Source/WebCore/dom/Document.cpp
+++ b/Source/WebCore/dom/Document.cpp
@@ -373,6 +373,7 @@
 #include <wtf/RuntimeApplicationChecks.h>
 #include <wtf/SetForScope.h>
 #include <wtf/SystemTracing.h>
+#include <cstdlib>
 #include <wtf/TZoneMallocInlines.h>
 #include <wtf/UUID.h>
 #include <wtf/text/MakeString.h>
@@ -4662,6 +4663,26 @@
     if (m_isTimerThrottlingEnabled)
         alignmentInterval = std::max(alignmentInterval, DOMTimer::hiddenPageAlignmentInterval());
 
+    // While the top-level document is still loading, batch maximally-nested
+    // timers onto a coarser alignment grid so setTimeout storms (ads,
+    // analytics, pollers) fire in aligned bursts instead of saturating the
+    // main thread; the gaps between bursts let queued input events (touch
+    // scrolling) get serviced during page load. Only timers past the max
+    // nesting level are affected -- fresh one-shot timers and chunked-work
+    // chains below the nesting cap keep their exact timing, so load progress
+    // is not slowed. Reverts to stock behavior the moment the load event
+    // fires. WEBKIT_LOADING_TIMER_ALIGNMENT_MS overrides (default 50; 0
+    // disables).
+    static const Seconds loadingTimerAlignmentInterval = []() -> Seconds {
+        const char* env = getenv("WEBKIT_LOADING_TIMER_ALIGNMENT_MS");
+        double ms = env ? atof(env) : 50.0;
+        return ms > 0 ? Seconds::fromMilliseconds(ms) : Seconds(0);
+    }();
+    if (loadingTimerAlignmentInterval > 0_s) {
+        if (RefPtr mainDocument = mainFrameDocument(); mainDocument && mainDocument->readyState() != ReadyState::Complete)
+            alignmentInterval = std::max(alignmentInterval, loadingTimerAlignmentInterval);
+    }
+
     if (RefPtr page = this->page())
         alignmentInterval = std::max(alignmentInterval, page->domTimerAlignmentInterval());
 
