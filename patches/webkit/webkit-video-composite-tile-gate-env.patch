+// WEBKIT_VIDEO_COMPOSITE_UNGATED=1 (default OFF): let a composition request whose
+// reason is NOT (only) a rendering update start the render timer even while the
+// compositor is waiting for a tile batch. See scheduleUpdateLocked().
+static bool atlVideoCompositeUngated()
+{
+    static const bool on = [] {
+        const char* e = getenv("WEBKIT_VIDEO_COMPOSITE_UNGATED");
+        return e && e[0] && e[0] != '0';
+    }();
+    return on;
+}
