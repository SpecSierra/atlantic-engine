+bool BitmapImage::shouldDrawFromCachedSubimage(GraphicsContext& context) const
+{
+    if (!cachedSubimageEnabled() || context.paintingDisabled())
+        return false;
+
+    // The caller's orientation and animation gating both read parsed metadata.
+    // Until headers are in, orientation() reports None for what may turn out to
+    // be a rotated image, which would bake a wrongly-mapped raster into the cache.
+    // A non-empty size() means the header pass (which also yields the
+    // orientation) has completed.
+    if (size().isEmpty())
+        return false;
+
+    // Animated images change contents under the cache on every frame.
+    if (m_source->isAnimated())
+        return false;
+
+    // Recording contexts replay at arbitrary scales; baking a raster at today's
+    // scale into a display list would show up as blurring after a zoom.
+    return context.renderingMode() != RenderingMode::DisplayList;
+}
