+// Hard cap on how long the load throttle may stay engaged: pages with a
+// never-settling progress tracker (live feeds, hanging subresources) must not
+// run at the reduced cadence indefinitely.
+static Seconds loadRenderingThrottleMaxDuration()
+{
+    static Seconds duration = [] {
+        const char* v = getenv("WEBKIT_LOAD_RENDERING_THROTTLE_MAX_MS");
+        int ms = v ? atoi(v) : 10000;
+        return Seconds::fromMilliseconds(std::max(ms, 0));
+    }();
+    return duration;
+}
+
+bool Page::isRenderingThrottledForLoad() const
+{
+    if (!m_renderingThrottledForLoad)
+        return false;
+    return MonotonicTime::now() - m_renderingThrottledForLoadStartTime < loadRenderingThrottleMaxDuration();
+}
+
