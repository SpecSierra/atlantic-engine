# Black tiles on the Jolla Phone 2: GL-state log and three experiments
# (diagnostic, everything default OFF).
#
# A whole-tile GPU replay is lost entirely unless a Skia readPixels follows
# playback, one per tile (one per burst: 12/12 black, build 752). Nothing so far
# says whether the replay's draws fail, land in another framebuffer, or are drawn
# and then lost. With WEBKIT_TILE_RESET_LOG>=2 each whole-tile GPU replay now
# prints, after its flush:
#   [tilegl] tile=... tex=<tile texture> fbo=<bound> attached=<colour attachment>
#            status=<completeness> err=<GL errors> err_before=<pending before> ctx=
# WEBKIT_TILE_GPU_EXPERIMENT (run with WEBKIT_TILE_GPU_READBACK_SYNC=0):
#   1  GrDirectContext::resetContext() before playback (stale Skia GL state?)
#   2  resetContext() after the flush (does the readback help the NEXT tile?)
#   3  raw glReadPixels of one pixel after the flush (is any read enough?)
#
# ---
diff --git a/Source/WebCore/platform/graphics/skia/SkiaPaintingEngine.cpp b/Source/WebCore/platform/graphics/skia/SkiaPaintingEngine.cpp
--- a/Source/WebCore/platform/graphics/skia/SkiaPaintingEngine.cpp
+++ b/Source/WebCore/platform/graphics/skia/SkiaPaintingEngine.cpp
@@ -58,6 +58,7 @@
 #endif
 WTF_IGNORE_WARNINGS_IN_THIRD_PARTY_CODE_BEGIN
 #if USE(LIBEPOXY)
+#include <epoxy/egl.h>
 #include <epoxy/gl.h>
 #else
 #include <GLES3/gl3.h>
@@ -400,6 +401,29 @@
     return enabled;
 }
 
+// WEBKIT_TILE_GPU_EXPERIMENT (diagnostic, default 0): what makes a whole-tile
+// GPU replay disappear on the Jolla Phone 2 unless a Skia readPixels follows
+// playback? Each value changes one thing around a whole-tile GPU replay, to be
+// run with WEBKIT_TILE_GPU_READBACK_SYNC=0 against the black-tile protocol:
+//   1  GrDirectContext::resetContext() before playback. A cure means Skia's
+//      cached GL state was stale (something else issued GL in its context).
+//   2  resetContext() after the flush. A cure means the readback helps the NEXT
+//      tile by dropping Skia's cached state, not the tile it reads.
+//   3  raw glReadPixels of one pixel after the flush, no Skia involved. A cure
+//      means any read of the framebuffer does it (driver-side resolve), no cure
+//      means it has to happen before the flush, as Skia's readPixels does.
+// WEBKIT_TILE_RESET_LOG>=2 also prints the GL state left by each whole-tile GPU
+// replay ([tilegl]): errors raised, framebuffer bound, its status and what is
+// attached to it, against the tile's own texture.
+static int tileGpuExperiment()
+{
+    static const int mode = [] {
+        const char* env = getenv("WEBKIT_TILE_GPU_EXPERIMENT");
+        return env ? atoi(env) : 0;
+    }();
+    return mode;
+}
+
 // WEBKIT_TILE_ALLOC_SYNC=1 (glFlush) / 2 (glFinish), default OFF.
 //
 // createBuffer() runs on the MAIN thread (updateBackingStore -> replay) with the
@@ -592,6 +616,14 @@
         const int tileLogLevel = TileResetLog::level();
         const bool logReplay = tileLogLevel >= 2 && dirtyRect == tileRect;
         auto* canvas = buffer->canvas();
+        const bool wholeTileGpu = canvas && dirtyRect == tileRect && buffer->isBackedByOpenGL() && static_cast<CoordinatedAcceleratedTileBuffer&>(buffer.get()).texture();
+        unsigned glErrorBeforeReplay = 0;
+        if (wholeTileGpu && logReplay)
+            glErrorBeforeReplay = glGetError();
+        if (wholeTileGpu && tileGpuExperiment() == 1) {
+            if (auto* grContext = PlatformDisplay::sharedDisplay().skiaGrContext())
+                grContext->resetContext();
+        }
         if (!canvas && tileLogLevel >= 1) {
             fprintf(stderr, "[tilepaint] NO-CANVAS gl=%d tile=%dx%d+%d+%d dirty=%dx%d+%d+%d\n", buffer->isBackedByOpenGL() ? 1 : 0,
                 tileRect.width(), tileRect.height(), tileRect.x(), tileRect.y(), dirtyRect.width(), dirtyRect.height(), dirtyRect.x(), dirtyRect.y());
@@ -666,6 +698,27 @@
         }
 
         buffer->completePainting();
+        if (wholeTileGpu && logReplay) {
+            unsigned errors[2] = { glGetError(), glGetError() };
+            GLint boundFramebuffer = -1;
+            GLint attachedName = -1;
+            glGetIntegerv(GL_FRAMEBUFFER_BINDING, &boundFramebuffer);
+            unsigned status = glCheckFramebufferStatus(GL_FRAMEBUFFER);
+            if (boundFramebuffer > 0)
+                glGetFramebufferAttachmentParameteriv(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_FRAMEBUFFER_ATTACHMENT_OBJECT_NAME, &attachedName);
+            fprintf(stderr, "[tilegl] tile=%dx%d+%d+%d tex=%u fbo=%d attached=%d status=%x err=%x,%x err_before=%x ctx=%p\n",
+                tileRect.width(), tileRect.height(), tileRect.x(), tileRect.y(),
+                static_cast<CoordinatedAcceleratedTileBuffer&>(buffer.get()).texture()->id(), boundFramebuffer, attachedName, status,
+                errors[0], errors[1], glErrorBeforeReplay, eglGetCurrentContext());
+        }
+        if (wholeTileGpu && tileGpuExperiment() == 2) {
+            if (auto* grContext = PlatformDisplay::sharedDisplay().skiaGrContext())
+                grContext->resetContext();
+        }
+        if (wholeTileGpu && tileGpuExperiment() == 3) {
+            uint32_t pixel = 0;
+            glReadPixels(0, 0, 1, 1, GL_RGBA, GL_UNSIGNED_BYTE, &pixel);
+        }
         platformLayer->didPaintTile();
     };
 
