+void ScrollerCoordinated::updateSprite(CoordinatedPlatformLayer& hostLayer, ScrollerImpAdwaita& scrollerImp, ScrollerPairCoordinated& pair, const ScrollerPairCoordinated::Values& values, AdwaitaScrollbarPainter::State& state, bool stateChanged)
+{
+    const int scrollbarWidth = AdwaitaScrollbarPainter::scrollbarSize;
+    const int minimumThumbLength = AdwaitaScrollbarPainter::minimumThumbSize;
+
+    int thumbLength = 0;
+    if (values.visibleSize > minimumThumbLength)
+        thumbLength = std::max<int>(values.visibleSize * values.proportion, minimumThumbLength);
+    if (thumbLength <= 0) {
+        {
+            Locker locker { m_lock };
+            m_spriteThumbLength = 0;
+            m_displayedThumbPosition = -1;
+            m_glidePending = false;
+        }
+        Locker layerLocker { hostLayer.lock() };
+        hostLayer.setContentsBuffer(nullptr);
+        return;
+    }
+
+    float targetPosition = (values.visibleSize - thumbLength) * values.value;
+
+    float displayedPosition;
+    bool glidePending = false;
+    bool repaintSprite;
+    {
+        Locker locker { m_lock };
+        float factor = scrollbarSmoothingFactor();
+        if (m_displayedThumbPosition < 0 || factor >= 1)
+            m_displayedThumbPosition = targetPosition;
+        else {
+            m_displayedThumbPosition += (targetPosition - m_displayedThumbPosition) * factor;
+            if (std::abs(targetPosition - m_displayedThumbPosition) < 1)
+                m_displayedThumbPosition = targetPosition;
+            else
+                glidePending = true;
+        }
+        m_glidePending = glidePending;
+        displayedPosition = m_displayedThumbPosition;
+        repaintSprite = stateChanged || thumbLength != m_spriteThumbLength;
+        if (repaintSprite)
+            m_spriteThumbLength = thumbLength;
+    }
+
+    if (repaintSprite) {
+        IntSize spriteSize = m_orientation == ScrollbarOrientation::Vertical ? IntSize(scrollbarWidth, thumbLength) : IntSize(thumbLength, scrollbarWidth);
+
+        state.thumbPosition = 0;
+        state.thumbLength = thumbLength;
+        state.frameRect = { { }, spriteSize };
+
+        // Rasterize on the CPU: a plain glTexSubImage2D upload of a tiny
+        // bitmap, instead of Ganesh GPU painting, keeps the fragile
+        // second-GL-context work out of the scrollbar path entirely.
+        SkBitmap bitmap;
+        if (!bitmap.tryAllocPixels(SkImageInfo::MakeN32Premul(spriteSize.width(), spriteSize.height())))
+            return;
+        bitmap.eraseColor(SK_ColorTRANSPARENT);
+        SkCanvas canvas(bitmap);
+        GraphicsContextSkia context(canvas, RenderingMode::Unaccelerated, RenderingPurpose::DOM);
+        scrollerImp.paint(context, state.frameRect, state);
+
+        auto& display = PlatformDisplay::sharedDisplay();
+        auto* glContext = display.skiaGLContext();
+        if (!glContext)
+            return;
+        GLContext::ScopedGLContextCurrent scopedCurrent(*glContext);
+
+        Ref texture = BitmapTexturePool::singleton().acquireTexture(spriteSize, { BitmapTexture::Flags::SupportsAlpha });
+        texture->updateContents(bitmap.getPixels(), IntRect({ }, spriteSize), IntPoint(), bitmap.rowBytes(), PixelFormat::BGRA8);
+        auto fence = GLFence::create(display.glDisplay());
+        if (!fence)
+            glFinish();
+        auto buffer = CoordinatedPlatformLayerBufferRGB::create(WTF::move(texture), { TextureMapperFlags::ShouldBlend }, WTF::move(fence));
+        if (!buffer)
+            return;
+
+        Locker layerLocker { hostLayer.lock() };
+        hostLayer.setContentsBuffer(WTF::move(buffer));
+    }
+
+    FloatRect spriteRect = m_orientation == ScrollbarOrientation::Vertical
+        ? FloatRect(0, displayedPosition, scrollbarWidth, thumbLength)
+        : FloatRect(displayedPosition, 0, thumbLength, scrollbarWidth);
+
+    {
+        Locker layerLocker { hostLayer.lock() };
+        hostLayer.setContentsRect(spriteRect);
+        hostLayer.setContentsClippingRect(FloatRoundedRect(spriteRect));
+    }
+
+    // Keep an unfinished glide converging even when scroll ticks stop: one
+    // pending catch-up tick on the compositing run loop re-enters
+    // updateValues until the filter reaches the target.
+    if (glidePending) {
+        bool schedule;
+        {
+            Locker locker { m_lock };
+            schedule = !std::exchange(m_catchUpScheduled, true);
+        }
+        if (schedule) {
+            if (RunLoop* runLoop = hostLayer.compositingRunLoop()) {
+                runLoop->dispatchAfter(Seconds(1.0 / 60.0), [pair = Ref { pair }, orientation = m_orientation] {
+                    auto& scroller = orientation == ScrollbarOrientation::Vertical ? pair->verticalScroller() : pair->horizontalScroller();
+                    {
+                        Locker locker { scroller.m_lock };
+                        scroller.m_catchUpScheduled = false;
+                    }
+                    scroller.updateValues();
+                });
+            }
+        }
+    }
+}
