+// WEBKIT_SCROLLBAR_SPRITE (default off = upstream): paint the overlay thumb
+// once into a small CPU-rasterized sprite and move it with setContentsRect
+// instead of GPU-repainting a full-track texture on every scroll frame.
+// Device-measured root cause of "the scrollbar blinks and teleports": the
+// upstream path paints the thumb with Skia Ganesh into a *reused pooled GL
+// texture* from the scrolling thread on each tick, relying on GL fences for
+// cross-context ordering — and this libhybris/Adreno stack does not order
+// them reliably, so the compositor intermittently samples the texture's
+// previous pool contents (a stale thumb position = teleport) or its cleared
+// transparent state (= blink). The sprite makes per-frame updates pure
+// compositor geometry: no painting, no texture churn, nothing to desync.
+// See webkit-scrollbar-sprite-and-smoothing.patch.
+static bool scrollbarSpriteEnabled()
+{
+    static bool enabled = [] {
+        const char* env = std::getenv("WEBKIT_SCROLLBAR_SPRITE");
+        return env && *env && strcmp(env, "0");
+    }();
+    return enabled;
+}
+
+// WEBKIT_SCROLLBAR_SMOOTHING (0 < value <= 1, default 1 = no smoothing):
+// exponential low-pass filter on the displayed thumb position, applied per
+// scroll tick in sprite mode. Values below 1 turn any residual jump in the
+// scroll data (e.g. after a main-thread stall) into a quick glide instead of
+// a teleport; a compositor-run-loop catch-up tick keeps the glide converging
+// when scroll ticks stop.
+static float scrollbarSmoothingFactor()
+{
+    static float factor = [] {
+        if (const char* env = std::getenv("WEBKIT_SCROLLBAR_SMOOTHING")) {
+            float value = std::atof(env);
+            if (value > 0 && value <= 1)
+                return value;
+        }
+        return 1.0f;
+    }();
+    return factor;
+}
