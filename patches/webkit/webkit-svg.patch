+std::optional<ImageDrawResult> SVGImage::tryDrawCachedRasterForContainer(GraphicsContext& context, const FloatSize& containerSize, float containerZoom, const URL& initialFragmentURL, const FloatRect& dstRect, const FloatRect& srcRect, ImagePaintingOptions options)
+{
+    if (!svgRasterCacheEnabled() || m_paintingForRasterCache)
+        return std::nullopt;
+
+    // An animating document invalidates every frame; caching would only add
+    // buffer churn on top of the repaint. Luminance masks need the vector paint.
+    if (isAnimating() || context.drawLuminanceMask())
+        return std::nullopt;
+
+    FloatRect zoomedContainerRect(FloatPoint(), containerSize);
+    zoomedContainerRect.scale(containerZoom);
+    if (zoomedContainerRect.isEmpty() || srcRect.isEmpty() || dstRect.isEmpty())
+        return std::nullopt;
+
+    // Rasterize at the resolution the destination actually needs: device pixels
+    // per zoomed-container unit, i.e. the context scale combined with the
+    // srcRect -> dstRect mapping.
+    auto ctm = context.getCTM();
+    FloatSize scale(std::abs(ctm.xScale()) * dstRect.width() / srcRect.width(), std::abs(ctm.yScale()) * dstRect.height() / srcRect.height());
+    if (scale.isEmpty())
+        return std::nullopt;
+
+    FloatSize backingSize = zoomedContainerRect.size();
+    backingSize.scale(scale.width(), scale.height());
+    IntSize roundedBackingSize = expandedIntSize(backingSize);
+    if (roundedBackingSize.isEmpty())
+        return std::nullopt;
+    if (static_cast<double>(roundedBackingSize.width()) * roundedBackingSize.height() > svgRasterCacheMaxAreaPx())
+        return std::nullopt;
+
+    RefPtr<NativeImage> image;
+    for (size_t i = 0; i < m_rasterCache.size(); ++i) {
+        auto& entry = m_rasterCache[i];
+        if (entry.containerSize == containerSize && entry.containerZoom == containerZoom && entry.initialFragmentURL == initialFragmentURL && entry.backingSize == roundedBackingSize) {
+            image = entry.image;
+            if (i)
+                std::swap(m_rasterCache[0], m_rasterCache[i]);
+            break;
+        }
+    }
+
+    if (!image) {
+        // Force an unaccelerated buffer: this runs on the main thread during
+        // tile recording, and a Ganesh surface + readback there is the slow
+        // path on drivers without cross-context fence support.
+        RefPtr buffer = ImageBuffer::create(FloatSize(roundedBackingSize), RenderingMode::Unaccelerated, RenderingPurpose::DOM, 1, DestinationColorSpace::SRGB(), PixelFormat::BGRA8, nullptr);
+        if (!buffer)
+            return std::nullopt;
+        {
+            SetForScope paintingForRasterCache(m_paintingForRasterCache, true);
+            auto& bufferContext = buffer->context();
+            bufferContext.scale(FloatSize(roundedBackingSize.width() / zoomedContainerRect.width(), roundedBackingSize.height() / zoomedContainerRect.height()));
+            if (drawForContainer(bufferContext, containerSize, containerZoom, initialFragmentURL, zoomedContainerRect, zoomedContainerRect) != ImageDrawResult::DidDraw)
+                return std::nullopt;
+        }
+        image = ImageBuffer::sinkIntoNativeImage(WTF::move(buffer));
+        if (!image)
+            return std::nullopt;
+
+        static constexpr size_t maxRasterCacheEntries = 2;
+        if (m_rasterCache.size() >= maxRasterCacheEntries)
+            m_rasterCache.removeLast();
+        m_rasterCache.insert(0, RasterCacheEntry { containerSize, containerZoom, initialFragmentURL, roundedBackingSize, image });
+    }
+
+    // Map srcRect (zoomed-container coordinates) into backing pixels.
+    FloatRect scaledSrcRect = srcRect;
+    scaledSrcRect.scale(roundedBackingSize.width() / zoomedContainerRect.width(), roundedBackingSize.height() / zoomedContainerRect.height());
+    context.drawNativeImage(*image, dstRect, scaledSrcRect, options);
+
+    if (RefPtr observer = imageObserver())
+        observer->didDraw(*this);
+
+    return ImageDrawResult::DidDraw;
+}
