+static bool svgRasterCacheEnabled()
+{
+    static bool enabled = [] {
+        const char* env = getenv("WEBKIT_SVG_RASTER_CACHE");
+        return !env || !*env || strcmp(env, "0");
+    }();
+    return enabled;
+}
+
+static double svgRasterCacheMaxAreaPx()
+{
+    static double maxArea = [] {
+        if (const char* env = getenv("WEBKIT_SVG_RASTER_CACHE_MAX_AREA_PX")) {
+            if (double value = strtod(env, nullptr); value > 0)
+                return value;
+        }
+        return 4194304.; // 16 MB of BGRA backing.
+    }();
+    return maxArea;
+}
