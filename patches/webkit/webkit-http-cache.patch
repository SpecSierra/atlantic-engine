# A bounded on-flash HTTP cache that service-worker sites can also use.
# Merged from: webkit-url-cache-disk-capacity-env, webkit-sw-fallback-http-cache.
#
# WEBKIT_URL_CACHE_DISK_CAPACITY_MB overrides the cache-model-derived disk
# capacity in the NetworkProcess. This lets the ship config keep
# ATLANTIC_CACHE_MODEL=viewer (smallest RAM caches, no bfcache — the OOM lever)
# while still having a disk cache: DocumentViewer hardwires disk capacity to 0,
# so every repeat visit re-downloaded every subresource over the radio
# (device-verified: 8 KB of ~/.cache after weeks of use). runtime-common.sh ships
# 100 MB; unset/0 = stock capacity for the model. Needs the ~/.cache/wpe
# whitelist in the generated sailjail profile (build-rpms-native.sh) or the cache
# writes vanish inside the jail.
#
# The second half is required for that to mean anything on modern sites: when a
# service worker's fetch handler does not respondWith() (pass-through, e.g.
# theverge's ad-block SW), the stock fallback restarts as a raw network load that
# neither reads nor stores the HTTP disk cache — every subresource of every
# SW-controlled page re-downloaded on every visit. The pass-through case now goes
# through the normal cache-aware startRequest() path (device-proven: 0 -> 30/38
# disk-cache hits on theverge /_next/static). WEBKIT_SW_FALLBACK_HTTP_CACHE=0 =
# stock.
#
# ---
diff -ruN --no-dereference sq-A/Source/WebKit/NetworkProcess/NetworkResourceLoader.cpp sq-B/Source/WebKit/NetworkProcess/NetworkResourceLoader.cpp
--- a/Source/WebKit/NetworkProcess/NetworkResourceLoader.cpp
+++ b/Source/WebKit/NetworkProcess/NetworkResourceLoader.cpp
@@ -57,6 +57,7 @@
 #include "WebSharedWorkerServer.h"
 #include "WebsiteDataStore.h"
 #include "WebsiteDataStoreParameters.h"
+#include <cstdlib>
 #include <WebCore/BlobDataFileReference.h>
 #include <WebCore/COEPInheritenceViolationReportBody.h>
 #include <WebCore/CORPViolationReportBody.h>
@@ -2125,6 +2126,22 @@
         auto newRequest = serviceWorkerFetchTask->takeRequest();
         m_serviceWorkerFetchTask = nullptr;
 
+        // Atlantic: the service worker declined to handle this fetch and no
+        // network load has been started (the pass-through case, as opposed to
+        // the redirect-restart case below). Route through the normal
+        // cache-aware start path so the HTTP disk cache is consulted and the
+        // response is stored; the stock restartNetworkLoad path skips both
+        // (FirstLoad::No never calls retrieveCacheEntry and never arms
+        // m_bufferedDataForCache). See webkit-sw-fallback-http-cache.patch.
+        static bool swFallbackCacheDisabled = [] {
+            const char* v = getenv("WEBKIT_SW_FALLBACK_HTTP_CACHE");
+            return v && *v == '0';
+        }();
+        if (!swFallbackCacheDisabled && !m_wasStarted && !m_networkLoad) {
+            startRequest(newRequest);
+            return;
+        }
+
         if (RefPtr networkLoad = m_networkLoad)
             networkLoad->updateRequestAfterRedirection(newRequest);
 
diff -ruN --no-dereference sq-A/Source/WebKit/Shared/CacheModel.cpp sq-B/Source/WebKit/Shared/CacheModel.cpp
--- a/Source/WebKit/Shared/CacheModel.cpp
+++ b/Source/WebKit/Shared/CacheModel.cpp
@@ -27,6 +27,7 @@
 #include "CacheModel.h"
 
 #include <algorithm>
+#include <cstdlib>
 #include <wtf/RAMSize.h>
 #include <wtf/Seconds.h>
 #include <wtf/StdLibExtras.h>
@@ -127,6 +128,18 @@
 
 uint64_t calculateURLCacheDiskCapacity(CacheModel cacheModel, uint64_t diskFreeSize)
 {
+    // Atlantic: WEBKIT_URL_CACHE_DISK_CAPACITY_MB overrides the cache-model-
+    // derived HTTP disk cache capacity. The ship cache model (DocumentViewer,
+    // the RAM/OOM lever on the 3.5 GB device) hardwires the DISK cache to 0,
+    // so every repeat visit re-downloads all subresources - a large share of
+    // perceived "slow page loading". A bounded on-flash cache restores
+    // repeat-visit speed without moving any RAM knob. Unset or 0 = stock
+    // capacity for the model. See webkit-url-cache-disk-capacity-env.patch.
+    if (const char* capacityMB = getenv("WEBKIT_URL_CACHE_DISK_CAPACITY_MB")) {
+        if (long mb = atol(capacityMB); mb > 0)
+            return static_cast<uint64_t>(mb) * MB;
+    }
+
     uint64_t urlCacheDiskCapacity;
 
     switch (cacheModel) {
