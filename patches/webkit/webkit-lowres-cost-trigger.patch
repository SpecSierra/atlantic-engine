+// ── Cost-based degradation trigger ───────────────────────────────────────────
+// The speed ladder above asks "how fast is the page scrolling?". That is a pure
+// geometry question -- it describes how quickly tiles are being exposed, but not
+// what a tile COSTS to rasterize, and cost is what decides whether degrading is
+// a win or a loss. Measured on build 618/620 with the identical
+// WEBKIT_LOWRES_TILE_SCALE=0.3 knob:
+//
+//   raster-bound page (282 ns/px, 13.0 ms/tile)  p95 76ms -> 44ms  (-42%)
+//   cheap page        (11.9 ns/px, 0.8 ms/tile)  p95 27ms -> 29ms  (+7%),
+//                                                jank 1.3% -> 3.4%
+//
+// Raster cost separates those pages by 23.7x while their scroll velocities are
+// indistinguishable, so no velocity threshold can tell them apart. Re-calibrating
+// the thresholds was tried and rejected: it halved engagement on the cheap page
+// with zero change to the penalty, while giving up a quarter of the raster-bound
+// page's tail win.
+//
+// This trigger asks the question that actually determines the sign of the
+// outcome: "will the tiles this pass needs to paint fit in a frame?"
+//
+//   predictedMs = tileRasterNsPerPixel * pixelsToPaint
+//   overshoot   = predictedMs / frameBudgetMs
+//
+// engaging only when overshoot > 1. Because raster cost is ~linear in painted
+// pixels and a scale of s paints s^2 of them, the scale needed to fit the budget
+// is 1/sqrt(overshoot) -- so the degradation is proportional to the overload
+// instead of a fixed cliff. On the measured numbers a 3-tile exposure is 0.15x
+// budget on the cheap page (no degradation at any speed) and 2.35x on the
+// raster-bound one (scale 0.65, which fits the budget and is far less visible
+// than the current fixed 0.3x).
+//
+// WEBKIT_LOWRES_COST_TRIGGER=1 enables it; default OFF (the speed ladder stays
+// in charge) pending the on-device A/B.
+static bool costTriggerEnabled()
+{
+    static bool enabled = [] {
+        // Unset => ON. Device-validated against the legacy speed ladder, which on
+        // real reddit scrolling put 73% of samples into checkerboard (blank bands)
+        // at an effective 267 CSS px/s; this stays at low-res ~0.40 and blanks
+        // nothing. "0" falls back to the speed ladder.
+        const char* env = getenv("WEBKIT_LOWRES_COST_TRIGGER");
+        if (!env || !*env)
+            return true;
+        return strcmp(env, "0") != 0;
+    }();
+    return enabled;
+}
+
+// Per-frame raster budget. Not the full 16.6 ms frame: raster shares the frame
+// with compositing, upload and the rest of the pipeline, so budgeting the whole
+// vsync interval to raster alone guarantees a missed frame whenever the estimate
+// is exactly met. WEBKIT_LOWRES_COST_BUDGET_MS, default 11 ms (~2/3 of a 60 Hz
+// frame).
+static double costBudgetMs()
+{
+    static double ms = [] {
+        if (const char* env = getenv("WEBKIT_LOWRES_COST_BUDGET_MS")) {
+            double v = atof(env);
+            if (v > 1.0 && v <= 100.0)
+                return v;
+        }
+        return 11.0;
+    }();
+    return ms;
+}
+
+// Floor on the derived scale. Below ~0.3 the upscale blur is obvious on text and
+// the quality cost stops being worth the raster saved.
+// WEBKIT_LOWRES_COST_SCALE_FLOOR, default 0.3, clamped to [0.25, 1.0).
+static float costScaleFloor()
+{
+    static float floorScale = [] {
+        if (const char* env = getenv("WEBKIT_LOWRES_COST_SCALE_FLOOR")) {
+            float v = atof(env);
+            if (v >= 0.25f && v < 1.0f)
+                return v;
+        }
+        return 0.3f;
+    }();
+    return floorScale;
+}
+
+// Overshoot at which the top rung (checkerboard: skip the band entirely) takes
+// over from low-res. At the scale floor, low-res can only recover 1/floor^2 --
+// about 11x at 0.3 -- so past that point painting low-res still misses the frame
+// and showing background until rest is the better trade.
+// WEBKIT_LOWRES_COST_CHECKERBOARD_X, **default 0 (disabled)**. Measured: routing
+// to checkerboard at high overshoot pinned a heavy page in the blank-band tier
+// (p95 72ms, jank 16%, worst frame 645ms -- worse than no degradation at all).
+// Floor-scale low-res still removes ~11x of the work AND keeps content visible,
+// which is the better trade; set >0 only to re-enable the rung for an A/B.
+static double costCheckerboardOvershoot()
+{
+    static double x = [] {
+        if (const char* env = getenv("WEBKIT_LOWRES_COST_CHECKERBOARD_X")) {
+            double v = atof(env);
+            if (v >= 0.0)
+                return v;
+        }
+        return 0.0;  // disabled: the scale floor is the ceiling on degradation
+    }();
+    return x;
+}
+
+// Minimum overshoot before engaging at all. Engaging is not free: every degraded
+// tile is repainted whole at full resolution once motion settles, so a marginal
+// engagement spends a full repaint to save a little raster and comes out behind.
+// Measured: at a 0.90 derived scale (overshoot 1.24) the cheap page still paid
+// the entire +1.9pp jank penalty -- the cost is per ENGAGEMENT, not per unit of
+// degradation. Requiring real overshoot also stops the trigger firing on the
+// merely-slightly-loaded pages the user sees as "low res shows too early".
+// WEBKIT_LOWRES_COST_ENGAGE_X, default 2.0 (=> never engages above scale ~0.71).
+static double costEngageOvershoot()
+{
+    static double x = [] {
+        if (const char* env = getenv("WEBKIT_LOWRES_COST_ENGAGE_X")) {
+            double v = atof(env);
+            if (v >= 1.0 && v <= 100.0)
+                return v;
+        }
+        return 2.0;
+    }();
+    return x;
+}
+
+// How long after the last scroll movement the cost trigger may still degrade.
+//
+// THIS GATE IS LOAD-BEARING. Low-res is a scroll-time trade: it is only
+// acceptable because the eye cannot resolve detail mid-fling and the tiles are
+// repainted sharp at rest. Applied to a STATIONARY page it is pure loss -- the
+// user just sees a permanently blurry page. Worse, the low-res upscale has a
+// latent edge artifact (lowResBufferSize rounds up with ceil(), so a 256px tile
+// at 0.3 paints 76.8 of 77 texels and the unpainted fraction upscales into a
+// visible seam at every tile boundary); while degradation is transient that
+// artifact flashes by unnoticed, but held at rest it becomes a permanent dark
+// GRID across the page. Both were observed on franceinfo.fr: 99 layer proxies
+// degraded to the 0.3 floor while the page sat idle.
+//
+// The speed ladder got this for free -- it could only arm inside setVisibleRect
+// when dy != 0. The cost trigger evaluates on every layer flush, so it must
+// reinstate the condition explicitly.
+// WEBKIT_LOWRES_COST_MOTION_MS, default 250 -- wide enough to span the gaps
+// between layer flushes on a heavy page, short enough to end promptly at rest.
+static double costMotionWindowMs()
+{
+    static double ms = [] {
+        if (const char* env = getenv("WEBKIT_LOWRES_COST_MOTION_MS")) {
+            double v = atof(env);
+            if (v >= 0 && v <= 2000)
+                return v;
+        }
+        return 250.0;
+    }();
+    return ms;
+}
+
+// Scroll motion is a PAGE-level fact, so it is tracked process-wide rather than
+// per backing store.
+//
+// The per-proxy version of this was wrong for the same reason the speed ladder's
+// `dt < 0.2` sample gate is wrong, and it is worth stating once because it has now
+// caused two separate bugs. A real page is many compositing layers -- franceinfo
+// has ~99 -- and each proxy's setVisibleRect / updateIfNeeded runs only when THAT
+// layer changes. Any single layer therefore sees sparse, irregular updates: its
+// own dt routinely exceeds 200 ms (so the speed ladder discards 536 of 536 samples
+// and never arms on a real page at all), and its own last-motion timestamp is
+// routinely older than the motion window (so the cost trigger saw scrolling=0 for
+// every one of 964 samples while the page was being flung).
+//
+// Neither is a property of the layer. Whether the USER is scrolling is a property
+// of the page: a fixed header never moves and a parallax layer moves at its own
+// rate, but the page is scrolling in both cases. One process-wide timestamp,
+// written by whichever layer observes movement and read by all of them, is both
+// correct and immune to per-layer sampling sparsity.
+//
+// Relaxed atomic: a smoothed liveness flag read across threads, where a slightly
+// stale read costs nothing and a lock on this path would cost more than the
+// signal.
+static std::atomic<double> s_lastScrollMotionSeconds { 0.0 };
+
+static void noteScrollMotion()
+{
+    s_lastScrollMotionSeconds.store(MonotonicTime::now().secondsSinceEpoch().value(),
+        std::memory_order_relaxed);
+}
+
+static bool pageIsScrolling(double windowMs)
+{
+    double last = s_lastScrollMotionSeconds.load(std::memory_order_relaxed);
+    if (last <= 0)
+        return false;
+    double nowSec = MonotonicTime::now().secondsSinceEpoch().value();
+    return (nowSec - last) * 1000.0 <= windowMs;
+}
+
+// Asymmetric hysteresis: engage on a single over-budget pass (a missed frame is
+// already visible), but require this many consecutive comfortably-under-budget
+// passes before disengaging. Measured motivation: a trigger that hovers near its
+// threshold is worse than one that stays either side of it -- at 43-46% armed the
+// heavy page's jank returned to baseline while raster CPU stayed elevated,
+// because every engage/disengage cycle costs a whole-tile full-res sharpen
+// repaint. WEBKIT_LOWRES_COST_DISENGAGE_PASSES, default 4.
+static unsigned costDisengagePasses()
+{
+    static unsigned n = [] {
+        if (const char* env = getenv("WEBKIT_LOWRES_COST_DISENGAGE_PASSES")) {
+            int v = atoi(env);
+            if (v >= 1 && v <= 60)
+                return static_cast<unsigned>(v);
+        }
+        return 4u;
+    }();
+    return n;
+}
