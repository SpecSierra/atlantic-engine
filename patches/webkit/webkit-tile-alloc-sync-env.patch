+        auto texture = BitmapTexturePool::singleton().acquireTexture(size, textureFlags);
+        if (auto mode = tileAllocSyncMode()) {
+            if (mode >= 2)
+                glFinish();
+            else
+                glFlush();
+        }
+        return CoordinatedAcceleratedTileBuffer::create(WTF::move(texture));
     }
 
