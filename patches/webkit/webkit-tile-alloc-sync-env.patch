+// WEBKIT_TILE_ALLOC_SYNC=1 (glFlush) / 2 (glFinish), default OFF.
+//
+// createBuffer() runs on the MAIN thread (updateBackingStore -> replay) with the
+// main thread's Skia GL context current, so a tile texture freshly allocated by
+// the pool (glTexImage2D in BitmapTexture::create) is defined in that context --
+// but the tile is painted from ANOTHER context: the compositor thread's Skia
+// context (WEBKIT_RASTER_ON_COMPOSITOR_THREAD) or a GPU worker's. Nothing
+// flushes the allocating context, so on the Jolla Phone 2's Mali the allocation
+// can reach the GPU after the paint and leave the tile undefined (black): only
+// fresh allocations (a fling outrunning the pool), every GPU paint mode, never
+// CPU paint, and a producer-side glFinish does not help. This submits the
+// allocation before the texture leaves this context.
+static int tileAllocSyncMode()
+{
+    static const int mode = [] {
+        const char* env = getenv("WEBKIT_TILE_ALLOC_SYNC");
+        return env ? atoi(env) : 0;
+    }();
+    return mode;
+}
+
