# WEBKIT_TILE_ALLOC_SYNC=1 (glFlush) / 2 (glFinish), default OFF: submit a
# freshly allocated GPU tile texture before another GL context paints into it.
#
# createBuffer() runs on the MAIN thread (updateBackingStore -> replay) with the
# main thread's Skia context current, so a new pool texture's glTexImage2D is
# issued there, while the tile is painted from the compositor thread's Skia
# context (WEBKIT_RASTER_ON_COMPOSITOR_THREAD) or a GPU worker's. Suspected
# cause of the black tiles under GPU painting on the Jolla Phone 2 (Mali-G610):
# only some tiles created mid-fling, every GPU mode, never CPU painting; the
# black tile's single whole-tile paint had a non-empty recording; a
# producer-side glFinish (WPE_GL_FENCE_DISABLED=1) did not help (6/12 black),
# a pixel readback right after playback did (0/12).
--- a/Source/WebCore/platform/graphics/skia/SkiaPaintingEngine.cpp
+++ b/Source/WebCore/platform/graphics/skia/SkiaPaintingEngine.cpp
@@ -57,6 +57,12 @@
 #include "MemoryMappedGPUBuffer.h"
 #endif
 WTF_IGNORE_WARNINGS_IN_THIRD_PARTY_CODE_BEGIN
+#if USE(LIBEPOXY)
+#include <epoxy/gl.h>
+#else
+#include <GLES3/gl3.h>
