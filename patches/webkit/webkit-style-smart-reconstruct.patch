+void Scope::didChangeStyleSheetEnvironmentWeakly()
+{
+    // Atlantic: weak variant for the updateStyleForLayout FIXME (rdar://36670246) call site - the
+    // resolver being lazily cleared does not mean the stylesheet environment actually changed.
+    if (!smartReconstructEnabled()) {
+        didChangeStyleSheetEnvironment();
+        return;
+    }
+
+    RELEASE_ASSERT(!m_isUpdatingStyleResolver);
+    RELEASE_ASSERT(!m_document->isResolvingTreeStyle());
+
+    if (!m_shadowRoot) {
+        m_sharedShadowTreeResolvers.clear();
+
+        // Shadow tree scopes keep the stock (authoritative) treatment - only the document scope
+        // is downgraded.
+        for (Ref descendantShadowRoot : m_document->inDocumentShadowRoots())
+            const_cast<ShadowRoot&>(descendantShadowRoot.get()).styleScope().scheduleUpdate(UpdateType::ContentsOrInterpretation);
+
+        m_document->invalidateCachedCSSParserContext();
+    }
+
+    scheduleUpdate(UpdateType::ContentsOrInterpretation, IsAuthoritativeChange::No);
+}
