+    // Coalesce rendering updates during the main load. Stop the observer's busy
+    // per-iteration polling and instead schedule a single wakeup at the throttle
+    // deadline (loadRenderingThrottleTimerFired -> scheduleRenderingUpdate), which
+    // re-arms the observer to fire and proceed once the interval has elapsed. Dirty
+    // regions accumulate meanwhile, so the batched update paints the union once.
+    if (shouldDeferRenderingUpdateForLoad()) {
+        invalidateRenderingUpdateRunLoopObserver();
+        if (!m_loadRenderingThrottleTimer.isActive()) {
+            auto delay = (m_lastRenderingUpdateTime + loadRenderingThrottleInterval()) - MonotonicTime::now();
+            m_loadRenderingThrottleTimer.startOneShot(std::max(delay, 0_s));
+        }
+        return;
+    }
+
     updateRendering();
 }
 
