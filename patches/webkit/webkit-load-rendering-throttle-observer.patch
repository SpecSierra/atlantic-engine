+bool LayerTreeHost::shouldDeferRenderingUpdateForLoad()
+{
+    auto interval = loadRenderingThrottleInterval();
+    if (interval <= 0_s)
+        return false;
+
+    auto* corePage = m_webPage.corePage();
+    if (!corePage || !corePage->isRenderingThrottledForLoad()) {
+        m_loadThrottleActive = false;
+        return false;
+    }
+
+    auto now = MonotonicTime::now();
+    if (!m_loadThrottleActive) {
+        m_loadThrottleActive = true;
+        m_loadThrottleStartTime = now;
+    }
+
+    // Safety cap: stop throttling this load after the max window so a page that
+    // never finishes loading (reddit/onche hold the progress bar open) still
+    // renders at full rate eventually.
+    if (now - m_loadThrottleStartTime > loadRenderingThrottleMaxDuration)
+        return false;
+
+    // Never defer while the compositor is scrolling/compositing. Moving during a
+    // load reveals content whose tiles are painted by updateRendering; deferring it
+    // deadlocks the composition<-tiles<-flush handshake (m_isWaitingForRenderer
+    // sticks true -> permanent freeze on move-during-load, device-repro'd on
+    // onche.org). Only coalesce during quiet load with no compositor activity,
+    // which is the paint-storm case anyway.
+    if (isCompositionRequiredOrOngoing())
+        return false;
+
+    return now < m_lastRenderingUpdateTime + interval;
+}
+
+void LayerTreeHost::loadRenderingThrottleTimerFired()
+{
+    // Wake the run loop at the throttle deadline and re-arm the RenderingUpdate
+    // observer. The observer only fires at RunLoop BeforeWaiting, so without this
+    // timer a page that goes quiet mid-load would never repaint again (the 465-467
+    // freeze). scheduleRenderingUpdate() respects m_isWaitingForRenderer, so the
+    // compositor handshake is untouched.
+    scheduleRenderingUpdate();
+}
+
 void LayerTreeHost::updateRendering()
 {
     invalidateRenderingUpdateRunLoopObserver();
