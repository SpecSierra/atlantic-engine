+// See webkit-load-rendering-throttle-env.patch. On this port rendering updates are
+// paced by the RenderingUpdate RunLoopObserver (an activity observer that fires only
+// at RunLoop BeforeWaiting, i.e. only when the loop iterates), NOT the WebCore
+// RenderingUpdateScheduler/DisplayLink machinery, so the load-time coalescing lives
+// in the observer callback (renderingUpdateRunLoopObserverFired). Unset/0 = off.
+static Seconds loadRenderingThrottleInterval()
+{
+    static Seconds interval = [] {
+        const char* v = getenv("WEBKIT_LOAD_RENDERING_INTERVAL_MS");
+        int ms = v ? atoi(v) : 0;
+        return Seconds::fromMilliseconds(std::max(ms, 0));
+    }();
+    return interval;
+}
+
+// A single load never stays throttled longer than this (reddit/onche keep the
+// progress bar open indefinitely); after it we fall back to stock full-rate updates.
+static constexpr Seconds loadRenderingThrottleMaxDuration = 10_s;
+
 LayerTreeHost::LayerTreeHost(WebPage& webPage)
     : m_webPage(webPage)
     , m_sceneState(CoordinatedSceneState::create())
+    , m_loadRenderingThrottleTimer(*this, &LayerTreeHost::loadRenderingThrottleTimerFired)
 #if USE(CAIRO)
