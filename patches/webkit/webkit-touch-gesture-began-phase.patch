+            // the motion events built one controller's velocity history while the
+            // Ended event armed a different, empty controller, so the fling saw one
+            // sample and the page stopped dead. See webkit-touch-gesture-began-phase.patch.
+            generatedEvent.phase = m_axisGestureStarted ? WebWheelEvent::Phase::Changed : WebWheelEvent::Phase::Began;
+            m_axisGestureStarted = true;
 
