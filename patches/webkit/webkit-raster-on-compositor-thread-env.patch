 #if USE(COORDINATED_GRAPHICS) && USE(SKIA)
 #include "BitmapTexturePool.h"
 #include "CoordinatedBackingStoreProxy.h"
@@ -257,7 +260,7 @@ Ref<CoordinatedTileBuffer> SkiaPaintingEngine::replay(const GraphicsLayerCoordin
     auto buffer = createBuffer(renderingMode, bufferSize, recording->contentsOpaque());
     buffer->beginPainting();
 
-    m_paintingWorkerPool->postTask([platformLayer = WTF::move(platformLayer), buffer = Ref { buffer }, tileRect, dirtyRect, recording = WTF::move(recording), threadSafeGrContext = WTF::move(threadSafeGrContext)]() mutable {
+    auto rasterTask = [platformLayer = WTF::move(platformLayer), buffer = Ref { buffer }, tileRect, dirtyRect, recording = WTF::move(recording), threadSafeGrContext = WTF::move(threadSafeGrContext)]() mutable {
         if (auto* canvas = buffer->canvas()) {
             auto replayPicture = [](const sk_sp<SkPicture>& picture, SkCanvas* canvas, const IntRect& recordRect, const IntRect& tileRect, const IntRect& dirtyRect, bool isDDLBuffer) {
                 canvas->save();
@@ -288,11 +291,34 @@ Ref<CoordinatedTileBuffer> SkiaPaintingEngine::replay(const GraphicsLayerCoordin
 
         buffer->completePainting();
         platformLayer->didPaintTile();
-    });
+    };
+
+    // Route GPU rasterization to the compositor thread when enabled (see header).
+    // The serial compositor run loop runs these replay tasks (enqueued during the
+    // layer flush) before the render task scheduled by the subsequent scene
+    // commit, so each tile is fully painted on the same thread/command-stream
+    // that composites it — no cross-context fence required.
+    if (rasterOnCompositorThread() && m_compositorRunLoop)
+        m_compositorRunLoop->dispatch(WTF::move(rasterTask));
+    else
+        m_paintingWorkerPool->postTask(WTF::move(rasterTask));
 
     return buffer;
 }
 
+bool SkiaPaintingEngine::rasterOnCompositorThread()
+{
+    static std::once_flag onceFlag;
+    static bool enabled = false;
+
+    std::call_once(onceFlag, [] {
+        if (const char* envString = getenv("WEBKIT_RASTER_ON_COMPOSITOR_THREAD"))
+            enabled = envString[0] && strcmp(envString, "0");
+    });
+
+    return enabled;
+}
