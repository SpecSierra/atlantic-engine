+// Diagnostic (WEBKIT_STYLE_LOG=1): report whether a content-mutated active sheet is
+// eligible for an incremental resolver append (mutated sheet is the LAST active author
+// sheet -> the appended rule lands last in the cascade, so no reorder is needed).
+// Answers whether the CSS-in-JS insertRule pattern that dominates franceinfo's style
+// cost can take a targeted fast path vs the current full resolver Reconstruct.
+void Scope::reportContentMutationForDiagnostic(const CSSStyleSheet& sheet, bool isInsertion)
+{
+    if (!styleLogEnabled())
+        return;
+    bool isLastActive = !m_activeStyleSheets.isEmpty() && m_activeStyleSheets.last().ptr() == &sheet;
+    fprintf(stderr, "[stylelog] contentMutation sheet=%p insertion=%d active=%d isLastActive=%d activeCount=%u\n",
+        &sheet, isInsertion ? 1 : 0, activeStyleSheetsContains(sheet) ? 1 : 0, isLastActive ? 1 : 0,
+        static_cast<unsigned>(m_activeStyleSheets.size()));
+}
