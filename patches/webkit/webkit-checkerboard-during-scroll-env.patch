+// Aggressive checkerboard during fast scroll. The coordinated-graphics port
+// always rasterizes at least the visible rect every time the viewport moves, so
+// a fast fling pays the per-tile paint cost (serialized by gpu-sync glFinish) on
+// the hot path. Gecko APZ and the Cocoa TileController instead decouple scroll
+// from paint: during a fling they show already-painted tiles plus the page
+// background for the exposed area, then paint once motion settles. This mirrors
+// that. While flinging faster than this many device px/s we stop rasterizing the
+// newly-exposed tiles (the gap shows the page background). WEBKIT_CHECKERBOARD_
+// DURING_SCROLL unset/0 = disabled (default); "1" = enabled at 800 px/s; a number
+// = that threshold in px/s.
+static float checkerboardScrollSpeedThreshold()
+{
+    static float threshold = [] {
+        if (const char* env = getenv("WEBKIT_CHECKERBOARD_DURING_SCROLL")) {
+            if (!*env || !strcmp(env, "0"))
+                return 0.0f;
+            float value = atof(env);
+            return value > 1.0f ? value : 800.0f;
+        }
+        return 0.0f;
+    }();
+    return threshold;
+}
+
+// Keep checkerboarding until this many ms after the LAST fast-scroll motion, so a
+// whole flick sequence stays checkerboarded and the tiles repaint only once, at
+// rest -- instead of repainting in the gaps between flicks. The longer this is,
+// the more aggressive the checkerboard. WEBKIT_CHECKERBOARD_SETTLE_MS (default 300).
+static double checkerboardSettleMs()
+{
+    static double ms = [] {
+        if (const char* env = getenv("WEBKIT_CHECKERBOARD_SETTLE_MS")) {
+            double v = atof(env);
+            if (v >= 0 && v <= 2000)
+                return v;
+        }
+        return 300.0;
+    }();
+    return ms;
+}
