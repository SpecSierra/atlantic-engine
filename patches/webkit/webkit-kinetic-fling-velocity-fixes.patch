 ScrollAnimationKinetic::~ScrollAnimationKinetic() = default;
 
+// A gesture's end (touch-up) event carries a zero delta, and on a busy page it can
+// arrive long after the last real finger motion — the main thread stalls, and the
+// synthesized end event lands hundreds of ms late. Pruning the history against
+// *that* timestamp discards every motion sample that preceded it, leaving a single
+// zero-delta event: one sample, zero span, zero delta, and therefore zero velocity.
+// The fling does not merely weaken, it never starts, and the page stops dead under
+// the finger. Device-measured on franceinfo.fr: 3 of 8 flicks (0 of 5 on an idle
+// local page). Only let events that actually carry motion age out the history.
+// WEBKIT_KINETIC_END_EVENT_FIX=0 restores the upstream behaviour for A/B.
+static bool kineticEndEventFixEnabled()
+{
+    static bool enabled = [] {
+        const char* v = getenv("WEBKIT_KINETIC_END_EVENT_FIX");
+        return !v || (*v && *v != '0');
+    }();
+    return enabled;
+}
+
+static bool wheelEventHasMotion(const PlatformWheelEvent& event)
+{
+    return event.deltaX() || event.deltaY();
+}
+
+// Cap on how much of the previous fling's velocity a stacked flick may add.
+// Upstream's 6.0 is desktop trackpad tuning; on touch, feed-scrolling with repeated
+// flicks compounds it into a runaway. 1.0 still lets a deliberate second flick add
+// roughly the previous fling's velocity (the familiar "flick harder to go faster"),
+// without the geometric blow-up. WEBKIT_KINETIC_VELOCITY_ACCUM_MAX (0..6) tunes it;
+// 6 restores upstream.
+static double kineticAccumulationMax()
+{
+    static double value = [] {
+        if (const char* env = getenv("WEBKIT_KINETIC_VELOCITY_ACCUM_MAX")) {
+            double v = atof(env);
+            // velocityAccumulationMax is upstream's value and the upper bound here,
+            // so setting it explicitly restores stock behaviour.
+            if (v >= 0.0 && v <= velocityAccumulationMax)
+                return v;
+        }
+        return 1.0;
+    }();
+    return value;
+}
+
+// Absolute ceiling on accumulated fling velocity, in px/s. 0 disables the clamp.
+// WEBKIT_KINETIC_MAX_VELOCITY tunes it.
+static double kineticMaxVelocity()
+{
+    static double value = [] {
+        if (const char* env = getenv("WEBKIT_KINETIC_MAX_VELOCITY")) {
+            double v = atof(env);
+            if (v >= 0.0 && v <= 100000.0)
+                return v;
+        }
+        return 10000.0;
+    }();
+    return value;
+}
+
