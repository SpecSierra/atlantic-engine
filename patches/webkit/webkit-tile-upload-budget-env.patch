+static size_t s_bytesThisFrame = 0;
+static bool s_deferredThisFrame = false;
+
+static size_t budgetBytes()
+{
+    static const size_t bytes = []() -> size_t {
+        if (const char* env = getenv("WEBKIT_TILE_UPLOAD_BUDGET_MB")) {
+            double mb = atof(env);
+            if (mb > 0 && mb <= 512)
+                return static_cast<size_t>(mb * 1024 * 1024);
+        }
+        return 0;
+    }();
+    return bytes;
+}
+
+bool enabled()
+{
+    return !!budgetBytes();
+}
+
+void beginFrame()
+{
+    s_bytesThisFrame = 0;
+    s_deferredThisFrame = false;
+}
+
+bool deferredThisFrame()
+{
+    return s_deferredThisFrame;
+}
+
+bool tryConsume(size_t bytes)
+{
+    // The first update of a frame always fits, so forward progress is
+    // guaranteed even when a single update exceeds the whole budget.
+    if (s_bytesThisFrame && s_bytesThisFrame + bytes > budgetBytes()) {
+        s_deferredThisFrame = true;
+        return false;
+    }
+    s_bytesThisFrame += bytes;
+    return true;
+}
+
+void noteDeferred()
+{
+    s_deferredThisFrame = true;
+}
+
