+// Per-composite tile upload budget (WEBKIT_TILE_UPLOAD_BUDGET_MB, unset/0 =
+// stock unlimited). All functions are compositor-thread only. When enabled,
+// CoordinatedBackingStoreTile::processPendingUpdates() defers (a) updates whose
+// buffer is still being painted by a worker (instead of blocking the composite
+// in waitUntilPaintingComplete) and (b) updates beyond the per-frame upload
+// byte budget. Deferred updates stay queued; ThreadedCompositor::renderLayerTree
+// checks deferredThisFrame() after the flush and schedules a follow-up composite
+// so they drain over subsequent frames. Lossy: stale/blank tile content shows
+// until the drain catches up.
+namespace TileUploadBudget {
+WEBCORE_EXPORT bool enabled();
+WEBCORE_EXPORT void beginFrame();
+WEBCORE_EXPORT bool deferredThisFrame();
+bool tryConsume(size_t bytes);
+void noteDeferred();
+} // namespace TileUploadBudget
+
