+
+bool tryConsume(size_t bytes)
+{
+    // The first update of a frame always fits, so forward progress is
+    // guaranteed even when a single update exceeds the whole budget.
+    if (s_bytesThisFrame && s_bytesThisFrame + bytes > budgetBytes()) {
+        s_deferredThisFrame = true;
+        return false;
+    }
+    s_bytesThisFrame += bytes;
+    return true;
+}
+
+void noteDeferred()
