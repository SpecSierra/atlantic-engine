@@ -81,6 +82,19 @@
     return m_platformLayer->id();
 }
 
+bool GraphicsLayerCoordinated::shouldRepaintOnSizeChange() const
+{
+    // The tiled backing store keeps existing tile content valid across
+    // resizes and paints only newly exposed tiles, so a whole-layer repaint
+    // on resize is redundant (renderer-level repaints cover content whose
+    // rendering actually changed).
+    static bool repaintOnResize = [] {
+        const char* v = getenv("WEBKIT_REPAINT_ON_LAYER_RESIZE");
+        return v && *v && *v != '0';
+    }();
+    return repaintOnResize && drawsContent();
+}
