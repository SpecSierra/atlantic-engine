+ImageDrawResult Image::drawFromCachedSubimage(GraphicsContext& context, const FloatRect& destinationRect, const FloatRect& sourceRect, ImagePaintingOptions options)
+{
+    // Re-entrancy guard: rasterizing the cache below calls back into draw(), which
+    // consults shouldDrawFromCachedSubimage() again. Without this the inner call
+    // would find a usable-looking (but still empty) cache and blit it into itself.
+    if (m_isRasterizingCachedSubimage)
+        return ImageDrawResult::DidNothing;
+
+    if (m_cachedSubimage && !m_cachedSubimage->canBeUsed(context, destinationRect, sourceRect))
+        m_cachedSubimage = nullptr;
+
+    if (!m_cachedSubimage) {
+        if (options.interpolationQuality() == InterpolationQuality::DoNotInterpolate)
+            m_cachedSubimage = CachedSubimage::createPixelated(context, destinationRect, sourceRect);
+        else
+            m_cachedSubimage = CachedSubimage::create(context, size(), destinationRect, sourceRect);
+
+        // The requested region does not fit the cache budget at this scale; the
+        // caller falls back to drawing the full-resolution bitmap directly.
+        if (!m_cachedSubimage)
+            return ImageDrawResult::DidNothing;
+
+        // createScaledImageBuffer() pre-translates and pre-scales the buffer's
+        // context, so the cache is filled using the same coordinate space as the
+        // outer draw. Callers only take this path for unrotated images, so the
+        // linear sourceRect <-> destinationRect mapping in CachedSubimage holds.
+        ImageDrawResult result;
+        {
+            SetForScope rasterizing(m_isRasterizingCachedSubimage, true);
+            result = draw(m_cachedSubimage->imageBuffer().context(), m_cachedSubimage->destinationRect(), m_cachedSubimage->sourceRect(), options);
+        }
+
+        // A frame that is still decoding (or failed) must not be latched into the
+        // cache, or the stale contents would be blitted on every later paint.
+        if (result != ImageDrawResult::DidDraw) {
+            m_cachedSubimage = nullptr;
+            return result;
+        }
+    }
+
+    m_cachedSubimage->draw(context, destinationRect, sourceRect);
+    return ImageDrawResult::DidDraw;
+}
