+// Large images that are painted scaled down (hero images, CMS-resized photos,
+// thumbnail grids) otherwise resample their full-resolution bitmap on every
+// repaint. Caching a display-resolution raster trades a bounded ImageBuffer for
+// that repeated resampling. Set WEBKIT_CACHED_SUBIMAGE=0 to A/B against stock.
+static bool cachedSubimageEnabled()
+{
+    static const bool enabled = [] {
+        const char* env = getenv("WEBKIT_CACHED_SUBIMAGE");
+        return !env || strcmp(env, "0");
+    }();
+    return enabled;
+}
+
+static bool shouldCacheSubimageForDrawing(GraphicsContext& context, const FloatRect& destinationRect, const FloatRect& sourceRect)
+{
+    // Below this many source pixels the ImageBuffer allocation and bookkeeping
+    // cost more than the resampling they save.
+    static const float minimumSourceArea = [] {
+        if (const char* env = getenv("WEBKIT_CACHED_SUBIMAGE_MIN_AREA")) {
+            if (float value = strtof(env, nullptr); value > 0)
+                return value;
+        }
+        return 256.f * 256.f;
+    }();
+
+    if (sourceRect.area() < minimumSourceArea)
+        return false;
+
+    // Cost and benefit are exact complements in the drawn scale: the cache
+    // buffer is the drawn area, so it costs scale^2 of a decoded frame, while
+    // the resampling it avoids is 1 - scale^2 of the per-paint work. Device-
+    // measured: at scale 0.11 the cache is ~1% of the decoded frame and saves
+    // ~99% of the resample; at 0.94 it costs ~88% of a decoded frame to save
+    // ~12%. So only cache below a scale where the trade is clearly worth it --
+    // 0.5 keeps >=75% of the benefit for <=25% of a decoded frame.
+    // WEBKIT_CACHED_SUBIMAGE_MAX_SCALE tunes it (1.0 = cache any downscale).
+    static const float maximumScale = [] {
+        if (const char* env = getenv("WEBKIT_CACHED_SUBIMAGE_MAX_SCALE")) {
+            if (float value = strtof(env, nullptr); value > 0 && value <= 1)
+                return value;
+        }
+        return 0.5f;
+    }();
+
+    auto effectiveScale = (destinationRect.size() / sourceRect.size()) * context.scaleFactor();
+    return effectiveScale.width() < maximumScale && effectiveScale.height() < maximumScale;
+}
