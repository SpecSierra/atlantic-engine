 {
     if (destinationRect.isEmpty() || sourceRect.isEmpty())
         return ImageDrawResult::DidNothing;
 
+    // Fast path: blit a previously rasterized display-resolution copy instead of
+    // resampling the full-resolution bitmap again. Restricted to unrotated,
+    // plain source-over draws so CachedSubimage's linear source <-> destination
+    // mapping holds and its blit (which does not carry a composite operator)
+    // stays equivalent to the direct draw.
+    auto resolvedOrientation = options.orientation() == ImageOrientation::Orientation::FromImage ? orientation() : options.orientation();
+    if (resolvedOrientation == ImageOrientation::Orientation::None
+        && options.compositeOperator() == CompositeOperator::SourceOver
+        && options.blendMode() == BlendMode::Normal
+        && shouldDrawFromCachedSubimage(context)
+        && shouldCacheSubimageForDrawing(context, destinationRect, sourceRect)) {
+        if (drawFromCachedSubimage(context, destinationRect, sourceRect, options) == ImageDrawResult::DidDraw) {
+            if (auto observer = imageObserver())
+                observer->didDraw(*this);
+            return ImageDrawResult::DidDraw;
+        }
+        // Fall through to the direct draw below on any cache miss.
+    }
