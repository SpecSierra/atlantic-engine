+// Diagnostic (WEBKIT_FLINGVEL_LOG=1): the fling velocity estimator was measured
+// receiving a single motion sample for an entire flick on a busy page, which makes
+// the fling impossible to compute rather than merely weak. That starvation is
+// upstream of the estimator, so count what this controller is actually fed: raw
+// touch motion events in, versus synthesized axis events out, per gesture. If "in"
+// is already ~1 the touch events never arrived and the loss is below this layer;
+// if "in" is healthy but "out" is 1, the loss is here.
+static bool touchGestureLogEnabled()
+{
+    static bool enabled = [] {
+        const char* v = getenv("WEBKIT_FLINGVEL_LOG");
+        return v && *v && *v != '0';
+    }();
+    return enabled;
+}
