+#if ENABLE(TOUCH_EVENTS)
+bool ViewLegacy::consumeTouchEventAck()
+{
+    // Called once per touch-event reply from the WebProcess (including
+    // page-handled ones), FIFO-matched with m_pendingTouchEventAcks. Returns
+    // true when the event belongs to a sequence that was gesture-recognized
+    // locally after the ack timeout, in which case the caller must not feed it
+    // to the gesture controller again.
+    if (m_pendingTouchEventAcks.isEmpty())
+        return false;
+    auto [generation, dispatchTime] = m_pendingTouchEventAcks.takeFirst();
+    if (!m_locallyHandledTouchGenerations.contains(generation))
+        return false;
+    // Prune once the last pending ack of a finished local sequence is consumed.
+    if (generation != m_touchSequenceGeneration && (m_pendingTouchEventAcks.isEmpty() || m_pendingTouchEventAcks.first().first != generation))
+        m_locallyHandledTouchGenerations.remove(generation);
+    return true;
+}
+#endif
