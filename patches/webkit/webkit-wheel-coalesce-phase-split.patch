Don't coalesce wheel events across scrolling phases on WPE.

A WPE touch flick is a run of Changed-phase motion events plus one Ended-phase event
(zero delta) that marks the gesture boundary the kinetic fling arms from.
WebWheelEventCoalescer::canCoalesce() gates its phase-equality check to
PLATFORM(COCOA), so on WPE the Ended event could merge into the motion stream. When
the WebProcess is slow to ack - i.e. on a heavy page - the queue fills and the whole
gesture, motion events and the Ended event alike, collapsed into a single event
carrying Phase::Ended, and the fling saw one sample: zero span, zero velocity, page
stops dead (device-traced on franceinfo.fr).

Apply the phase-inequality guard on WPE/GTK/libwpe, not just Cocoa. phase() is carried
on all these ports. WEBKIT_WHEEL_COALESCE_PHASE_SPLIT=0 restores the upstream
Cocoa-only behaviour. Complementary to webkit-touch-gesture-began-phase.patch: that
gives the gesture a start phase to latch on; this keeps distinct phases from merging.

--- a/Source/WebKit/Shared/WebWheelEventCoalescer.cpp	2026-07-20 21:45:39.503260687 +0000
+++ b/Source/WebKit/Shared/WebWheelEventCoalescer.cpp	2026-07-20 21:47:09.632811434 +0000
@@ -29,11 +29,23 @@
 #include "Logging.h"
 #include "NativeWebWheelEvent.h"
 #include "WebEventConversion.h"
+#include <cstdlib>
 #include <wtf/TZoneMallocInlines.h>
 #include <wtf/text/TextStream.h>
 
 namespace WebKit {
 
+// Whether events in different scrolling phases are kept from coalescing on non-Cocoa
+// ports. On by default (the fix); WEBKIT_WHEEL_COALESCE_PHASE_SPLIT=0 restores stock.
+static bool wheelCoalescePhaseSplitEnabled()
+{
+    static bool enabled = [] {
+        const char* v = getenv("WEBKIT_WHEEL_COALESCE_PHASE_SPLIT");
+        return !v || (*v && *v != '0');
+    }();
+    return enabled;
+}
+
 // Represents the number of wheel events we can hold in the queue before we start pushing them preemptively.
 constexpr unsigned wheelEventQueueSizeThreshold = 10;
 
@@ -57,9 +69,21 @@
         return false;
     if (a.granularity() != b.granularity())
         return false;
-#if PLATFORM(COCOA)
-    if (a.phase() != b.phase())
+#if PLATFORM(COCOA) || PLATFORM(GTK) || USE(LIBWPE) || ENABLE(WPE_PLATFORM)
+    // Events in different scrolling phases must never coalesce. On WPE the touch
+    // gesture recogniser emits Changed-phase motion events and a final Ended-phase
+    // event (zero delta) that marks the gesture boundary the kinetic fling is armed
+    // from. Upstream gates this check to Cocoa, so on WPE a whole flick's motion
+    // events plus the Ended event merged into ONE event carrying the merged delta and
+    // Phase::Ended — the fling then saw a single sample, zero time span, and computed
+    // zero velocity, so busy pages (franceinfo.fr) stopped dead under the finger
+    // instead of coasting. Device-traced: "COALESCE 9 events -> 1 ... endOfNonMomentum=1
+    // historySize=0". phase() is carried on all these ports, so apply the guard here.
+    // WEBKIT_WHEEL_COALESCE_PHASE_SPLIT=0 restores the upstream (Cocoa-only) behaviour.
+    if (wheelCoalescePhaseSplitEnabled() && a.phase() != b.phase())
         return false;
+#endif
+#if PLATFORM(COCOA)
     if (a.momentumPhase() != b.momentumPhase())
         return false;
 #endif
