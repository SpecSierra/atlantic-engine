 namespace WebCore {
 
+// WEBKIT_TILE_RESET_LOG=1 (default OFF, diagnostic): log every PARTIAL tile
+// update that lands on a texture whose previous contents were just discarded
+// (freshly acquired, reset, or dropped by a tile-rect change). Only the dirty
+// sub-rect is written into such a texture, so the rest of the tile shows
+// whatever the pool texture held -- the black root-layer tiles seen under GPU
+// painting on the Mali while a page is still loading.
+namespace TileResetLog {
+
+bool enabled()
+{
+    static const bool on = [] {
+        const char* env = getenv("WEBKIT_TILE_RESET_LOG");
+        return env && atoi(env);
+    }();
+    return on;
+}
+
+static const char* lossReason(const RefPtr<BitmapTexture>& texture, const IntSize& size, bool supportsAlpha)
+{
+    if (!texture)
+        return "no-texture";
+    if (texture->size() != size)
+        return "size";
+    if (supportsAlpha == texture->isOpaque())
+        return "alpha";
+    return nullptr;
+}
+
+static void logPartialOnLostTexture(const char* path, const char* reason, bool rectReset, bool wasLowRes, const IntRect& sourceRect, const IntRect& tileRect)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    fprintf(stderr, "[tilereset] %s partial reason=%s rect_reset=%d was_lowres=%d src=%dx%d+%d+%d tile=%dx%d+%d+%d t=%.1f\n",
+        path, reason, rectReset ? 1 : 0, wasLowRes ? 1 : 0,
+        sourceRect.width(), sourceRect.height(), sourceRect.x(), sourceRect.y(),
+        tileRect.width(), tileRect.height(), tileRect.x(), tileRect.y(),
+        ts.tv_sec * 1000.0 + ts.tv_nsec / 1.0e6);
+}
+
+} // namespace TileResetLog
+
