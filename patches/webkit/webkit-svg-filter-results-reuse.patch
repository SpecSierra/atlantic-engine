+    m_retiredResultsMap.clear();
+}
+
+void LegacyRenderSVGResourceFilter::retireFilterDataResults(RenderElement& client, FilterData& filterData)
+{
+    if (!svgFilterResultsReuseEnabled())
+        return;
+
+    if (filterData.state != FilterData::Built || !filterData.filter)
+        return;
+
+    auto results = filterData.filter->takeResults();
+    if (!results)
+        return;
+
+    // Bound the stash: entries whose renderer never rebuilds (e.g. the client
+    // was destroyed) must not accumulate result buffers.
+    static constexpr unsigned maxRetiredResults = 8;
+    if (m_retiredResultsMap.size() >= maxRetiredResults)
+        m_retiredResultsMap.clear();
+
+    m_retiredResultsMap.set(client, RetiredFilterResults { filterData.filter->referenceBox(), filterData.filter->filterRegion(), filterData.filter->filterScale(), filterData.sourceImageRect, WTF::move(results) });
 }
 
