+static bool svgFilterResultsReuseEnabled()
+{
+    static bool enabled = [] {
+        const char* env = getenv("WEBKIT_SVG_FILTER_RESULTS_REUSE");
+        return !env || !*env || strcmp(env, "0");
+    }();
+    return enabled;
+}
