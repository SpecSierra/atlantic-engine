+void FilterResults::clearSourceImageDependentResults()
+{
+    // Clear the source images and, transitively, every result computed from
+    // them, keeping only results of source-independent subgraphs (feTurbulence,
+    // feFlood, feImage chains) whose output cannot depend on the target's
+    // rendering.
+    Vector<Ref<FilterEffect>> sourceEffects;
+    for (auto& effect : m_results.keys()) {
+        if (effect->filterType() == FilterFunction::Type::SourceGraphic || effect->filterType() == FilterFunction::Type::SourceAlpha)
+            sourceEffects.append(effect);
+    }
+    for (auto& effect : sourceEffects)
+        clearEffectResult(effect);
+}
+
 } // namespace WebCore
