# Black tiles on the Jolla Phone 2: experiments between a tile's flush and the
# release of its Skia surface (diagnostic, default OFF).
#
# Build 753 result: the lost replays raise no GL error, are not tied to fresh
# textures, and whole rows go (the 1024 tile and its 8 px sliver together).
# WEBKIT_TILE_GPU_EXPERIMENT=1 (resetContext before playback) did not cure
# (6/6 black), so Skia's GL state cache is not stale. Values 2 and 3 were void:
# CoordinatedTileBuffer::completePainting() drops the SkSurface, which deletes
# the tile's framebuffer immediately after its draws are submitted, so they ran
# with framebuffer 0 bound.
#
# That immediate delete is the new suspect: a Skia readPixels (the known cure)
# is the only thing that touches the tile framebuffer between its draws and its
# deletion. WEBKIT_TILE_GPU_EXPERIMENT, with WEBKIT_TILE_GPU_READBACK_SYNC=0:
#   4  keep the last 8 surfaces alive (framebuffer deleted 8 tiles later)
#   5  raw glReadPixels of one pixel from the tile framebuffer
#   6  glFlush
#   7  glFinish
#
# ---
diff --git a/Source/WebCore/platform/graphics/texmap/coordinated/CoordinatedTileBuffer.cpp b/Source/WebCore/platform/graphics/texmap/coordinated/CoordinatedTileBuffer.cpp
--- a/Source/WebCore/platform/graphics/texmap/coordinated/CoordinatedTileBuffer.cpp
+++ b/Source/WebCore/platform/graphics/texmap/coordinated/CoordinatedTileBuffer.cpp
@@ -29,6 +29,7 @@
 #include "config.h"
 #include "CoordinatedTileBuffer.h"
 
+#include <cstdio>
 #include <cstdlib>
 
 #if USE(COORDINATED_GRAPHICS)
@@ -47,6 +48,7 @@
 #include <skia/gpu/ganesh/gl/GrGLDirectContext.h>
 WTF_IGNORE_WARNINGS_IN_THIRD_PARTY_CODE_END
 #include <wtf/MainThread.h>
+#include <wtf/Vector.h>
 
 #if USE(LIBEPOXY)
 #include <epoxy/gl.h>
@@ -225,6 +227,25 @@
     return m_recorder->getCanvas();
 }
 
+// WEBKIT_TILE_GPU_EXPERIMENT 4..7 (diagnostic, default 0), continuing the list in
+// SkiaPaintingEngine.cpp. The base class drops the SkSurface as soon as painting
+// completes, which deletes the tile's framebuffer right after its draws were
+// submitted. Values 2 and 3 there ran after that point (they saw framebuffer 0
+// bound), so they said nothing about the tile's own framebuffer. These run
+// between the flush and the release:
+//   4  keep the last 8 surfaces alive (framebuffer deleted 8 tiles later)
+//   5  raw glReadPixels of one pixel from the tile framebuffer
+//   6  glFlush
+//   7  glFinish
+static int tileSurfaceReleaseExperiment()
+{
+    static const int mode = [] {
+        const char* env = getenv("WEBKIT_TILE_GPU_EXPERIMENT");
+        return env ? atoi(env) : 0;
+    }();
+    return mode;
+}
+
 void CoordinatedAcceleratedTileBuffer::completePainting()
 {
     if (m_surface) {
@@ -236,6 +257,37 @@
         }
 
         m_fence = SkiaUtilities::flushAndSubmitSurfaceWithFence(grContext, m_surface.get());
+
+        switch (tileSurfaceReleaseExperiment()) {
+        case 4: {
+            // Released here, on the painting thread with its Skia context current.
+            static thread_local Vector<sk_sp<SkSurface>> keptSurfaces;
+            keptSurfaces.append(m_surface);
+            if (keptSurfaces.size() > 8)
+                keptSurfaces.removeAt(0);
+            break;
+        }
+        case 5: {
+            static bool logged = false;
+            if (!logged) {
+                logged = true;
+                GLint boundFramebuffer = -1;
+                glGetIntegerv(GL_FRAMEBUFFER_BINDING, &boundFramebuffer);
+                fprintf(stderr, "[tilegl] experiment 5 reads framebuffer %d\n", boundFramebuffer);
+            }
+            uint32_t pixel = 0;
+            glReadPixels(0, 0, 1, 1, GL_RGBA, GL_UNSIGNED_BYTE, &pixel);
+            break;
+        }
+        case 6:
+            glFlush();
+            break;
+        case 7:
+            glFinish();
+            break;
+        default:
+            break;
+        }
     } else if (m_recorder)
         m_displayList = m_recorder->detach();
 
