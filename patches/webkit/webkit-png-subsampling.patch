+void PNGImageDecoder::flushScaledRow(ScalableImageDecoderFrame& buffer, unsigned outputRow, int outputWidth)
+{
+    if (!m_scaleAccumulator || !m_scaleSampleCounts || !buffer.backingStore())
+        return;
+
+    auto destinationRow = buffer.backingStore()->pixelsStartingAt(0, outputRow);
+    auto address = destinationRow;
+    unsigned char nonTrivialAlphaMask = 0;
+
+    for (int x = 0; x < outputWidth; ++x, address = address.subspan(1)) {
+        WTF_ALLOW_UNSAFE_BUFFER_USAGE_BEGIN // non-Apple ports
+        uint32_t* accumulator = m_scaleAccumulator.get() + x * 4;
+        const unsigned samples = m_scaleSampleCounts[x];
+        const uint32_t alphaSum = accumulator[3];
+        unsigned r = 0, g = 0, b = 0, a = 0;
+        if (samples) {
+            a = alphaSum / samples;
+            if (alphaSum) {
+                r = accumulator[0] / alphaSum;
+                g = accumulator[1] / alphaSum;
+                b = accumulator[2] / alphaSum;
+            }
+        }
+        WTF_ALLOW_UNSAFE_BUFFER_USAGE_END
+        buffer.backingStore()->setPixel(address[0], r, g, b, a);
+        nonTrivialAlphaMask |= (255 - a);
+    }
+
+#if USE(LCMS)
+    // Once per OUTPUT row rather than per source row -- cheaper, and the colour
+    // transform is linear over the averaged result for our purposes.
+    if (m_iccTransform)
+        cmsDoTransform(m_iccTransform.get(), destinationRow.data(), destinationRow.data(), outputWidth);
+#endif
+
+    if (nonTrivialAlphaMask && !buffer.hasAlpha())
+        buffer.setHasAlpha(true);
+
+    zeroSpan(unsafeMakeSpan(m_scaleAccumulator.get(), outputWidth * 4));
+    zeroSpan(unsafeMakeSpan(m_scaleSampleCounts.get(), outputWidth));
+}
