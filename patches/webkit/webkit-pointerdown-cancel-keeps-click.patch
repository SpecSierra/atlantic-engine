@@ -2471,6 +2479,15 @@
     return nullptr;
 }
 
+bool EventHandler::shouldSuppressCompatibilityMouseEvent(const PlatformMouseEvent& platformMouseEvent) const
+{
+    // Only the mouse events the UIProcess synthesizes for a tap; a real mouse,
+    // and any event from a pointer sequence that did not cancel pointerdown,
+    // is untouched.
+    return m_suppressCompatibilityMouseEventsForTap
+        && platformMouseEvent.syntheticClickType() == SyntheticClickType::OneFingerTap;
+}
+
 bool EventHandler::swallowAnyClickEvent(const PlatformMouseEvent& platformMouseEvent, const MouseEventWithHitTestResults& mouseEvent, IgnoreAncestorNodesForClickEvent ignoreAncestorNodesForClickEvent)
 {
     if (!m_clickCount)
@@ -5546,11 +5563,23 @@
             *pointerTarget, event, index, !index, *document->windowProxy(), { 0, 0 });
 
         // https://w3c.github.io/pointerevents/#suppressing-a-compatibility-mouse-event
-        // If pointerdown was canceled via preventDefault(), suppress compatibility mouse events
-        // by marking the touch event as handled. This propagates to the UIProcess via
-        // doneWithTouchEvent(wasEventHandled=true), preventing gesture-based mouse synthesis.
-        if (page->pointerCaptureController().preventsCompatibilityMouseEventsForIdentifier(PointerEvent::pointerIdForTouchPoint(point)))
-            swallowedEvent = true;
+        // Canceling pointerdown suppresses the COMPATIBILITY MOUSE EVENTS
+        // (mousedown/mouseup). It does NOT suppress click, which the spec calls
+        // out explicitly.
+        //
+        // Marking the touch handled here did suppress click, and everything
+        // else: it reaches the UIProcess as doneWithTouchEvent(wasEventHandled
+        // = true), where PageClientImpl returns before TouchGestureController,
+        // so no tap is synthesized at all. Any overlay that cancels pointerdown
+        // to stop the field losing focus -- an extension's suggestion card, a
+        // custom menu -- became permanently untappable on a touch screen, while
+        // still highlighting under :active so it looked alive.
+        //
+        // Remember the suppression instead and drop only the mouse events when
+        // the synthesized tap comes back. Assigned rather than or'd so a
+        // sequence that does not cancel pointerdown clears it.
+        m_suppressCompatibilityMouseEventsForTap =
+            page->pointerCaptureController().preventsCompatibilityMouseEventsForIdentifier(PointerEvent::pointerIdForTouchPoint(point));
 #endif
 
