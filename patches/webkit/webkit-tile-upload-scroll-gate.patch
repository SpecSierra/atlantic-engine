 void CoordinatedBackingStore::processPendingUpdates()
 {
-    for (auto& tile : m_tiles.values())
-        tile.processPendingUpdates();
+    // Stock (and budget-at-rest) path: drain every tile; HashMap order is fine
+    // because everything uploads this composite anyway.
+    if (!TileUploadBudget::throttlingThisFrame()) {
+        for (auto& tile : m_tiles.values())
+            tile.processPendingUpdates();
+        return;
+    }
+
+    // Budgeted composite: drain tiles in scroll order (leading edge of the
+    // motion first, i.e. top-to-bottom when scrolling down), and once the byte
+    // budget is exhausted stop instead of letting whichever small update still
+    // fits jump the queue. Turns the fill-in from randomly popping squares into
+    // a progressive wave from the edge the user is scrolling toward.
+    Vector<CoordinatedBackingStoreTile*, 32> pendingTiles;
+    for (auto& tile : m_tiles.values()) {
+        if (tile.hasPendingUpdates())
+            pendingTiles.append(&tile);
+    }
+    if (pendingTiles.isEmpty())
+        return;
+
+    int direction = TileUploadBudget::scrollDirection();
+    std::sort(pendingTiles.begin(), pendingTiles.end(), [direction](auto* a, auto* b) {
+        auto rectA = a->firstPendingUpdateRect();
+        auto rectB = b->firstPendingUpdateRect();
+        if (rectA.y() != rectB.y())
+            return direction >= 0 ? rectA.y() < rectB.y() : rectA.y() > rectB.y();
+        return rectA.x() < rectB.x();
+    });
+
+    for (auto* tile : pendingTiles) {
+        if (TileUploadBudget::budgetExhaustedThisFrame())
+            break;
+        tile->processPendingUpdates();
+    }
 }
 
