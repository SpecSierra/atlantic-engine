-void SkiaPaintingEngine::paintIntoGraphicsContext(const GraphicsLayer& layer, GraphicsContext& context, const IntRect& dirtyRect, bool contentsOpaque, float contentsScale) const
+// During scroll a tile may be rasterized into a buffer scaled down by lowResScale
+// (the texture is upscaled back to its full rect at composite time). Everything
+// below works in full-resolution tile-local coordinates; the leading
+// context.scale(lowResScale) maps those into the smaller buffer.
+IntSize SkiaPaintingEngine::lowResBufferSize(const IntSize& fullSize, float lowResScale)
+{
+    if (lowResScale >= 1.0f || fullSize.isEmpty())
+        return fullSize;
+    // ROUND, never ceil. A buffer larger than the content painted into it leaves an
+    // unpainted fractional strip along the right/bottom edge: at 0.3 a 256 px tile
+    // paints 76.8 of a ceil()-sized 77 texels, and that transparent 0.2-texel column
+    // is bilinear-upscaled ~3.3x at composite time into a visible dark seam at every
+    // tile boundary -- the "tile edge grid" seen while scrolling. Rounding, combined
+    // with painting at lowResEffectiveScale() below, makes the content fill the
+    // buffer exactly, so there is no unpainted texel to sample.
+    return IntSize(
+        std::clamp(static_cast<int>(std::lround(fullSize.width() * lowResScale)), 1, fullSize.width()),
+        std::clamp(static_cast<int>(std::lround(fullSize.height() * lowResScale)), 1, fullSize.height()));
+}
+
+// The scale actually used when painting, derived from the integer buffer that will
+// hold the result rather than from the requested scale.
+//
+// The requested scale is a real number; the buffer is integral. Painting at the
+// requested scale therefore covers a fractional number of texels and leaves the
+// remainder unpainted (the seam above). Painting at bufferSize/fullSize instead
+// covers the buffer exactly, and because the compositor upscales that same buffer
+// back to the same full rect, the paint and composite ratios are exact inverses --
+// so tiles also stay aligned with each other, which floor()ing the buffer would
+// have broken (content would be stretched ~1% and adjacent tiles would misregister).
+FloatSize SkiaPaintingEngine::lowResEffectiveScale(const IntSize& fullSize, const IntSize& bufferSize)
 {
+    if (fullSize.isEmpty() || bufferSize.isEmpty())
+        return FloatSize(1.0f, 1.0f);
+    return FloatSize(static_cast<float>(bufferSize.width()) / fullSize.width(),
+        static_cast<float>(bufferSize.height()) / fullSize.height());
+}
