+// WEBKIT_DROP_TILES_WHEN_HIDDEN: drop this WebProcess's tiled-backing tiles
+// while its page is hidden (backgrounded tab), so a hidden tab holds ~0 GPU
+// tile memory instead of pinning its full cover (~1 GB measured). Rebuilt on
+// show. Default off — enabled per-build for A/B until device-validated (the
+// tiles only actually leave GPU once a composite runs while hidden).
+static std::atomic<bool> s_processPageHidden { false };
+
+bool CoordinatedBackingStoreProxy::dropTilesWhenHiddenEnabled()
+{
+    static bool enabled = [] {
+        const char* env = getenv("WEBKIT_DROP_TILES_WHEN_HIDDEN");
+        return env && *env && strcmp(env, "0");
+    }();
+    return enabled;
+}
+
+void CoordinatedBackingStoreProxy::setProcessPageHidden(bool hidden)
+{
+    s_processPageHidden.store(hidden, std::memory_order_relaxed);
+}
+
+// True when this WebProcess's page is hidden and the feature is enabled: every
+// layer then reports it needs no backing store, so updateContents() drops it.
+bool CoordinatedBackingStoreProxy::shouldDropAllTiles()
+{
+    return dropTilesWhenHiddenEnabled()
+        && s_processPageHidden.load(std::memory_order_relaxed);
+}
