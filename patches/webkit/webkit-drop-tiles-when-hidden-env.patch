+    // WEBKIT_DROP_TILES_WHEN_HIDDEN (default off): with one WebKitWebView per
+    // WebProcess, a backgrounded tab keeps its full tiled-backing cover
+    // resident (~1 GB of GPU tile textures measured on device) because the
+    // cover rect is computed purely from the visible rect and never considers
+    // page visibility. When the process's page is hidden, every backing store
+    // computes an empty cover rect so all tiles drop; they rebuild on show
+    // (resumePainting already issues a full setNeedsDisplay). Process-global
+    // because there is exactly one page per WebProcess here.
+    WEBCORE_EXPORT static bool dropTilesWhenHiddenEnabled();
+    WEBCORE_EXPORT static void setProcessPageHidden(bool);
+    WEBCORE_EXPORT static bool shouldDropAllTiles();
+
     const IntRect& coverRect() const { return m_coverRect; }
 
