diff -ruN --no-dereference sq-A/Source/JavaScriptCore/CMakeLists.txt sq-B/Source/JavaScriptCore/CMakeLists.txt
--- a/Source/JavaScriptCore/CMakeLists.txt
+++ b/Source/JavaScriptCore/CMakeLists.txt
@@ -1683,6 +1683,8 @@
 
 target_include_directories(LowLevelInterpreterLib
     PRIVATE "$<TARGET_PROPERTY:JavaScriptCore,INCLUDE_DIRECTORIES>" "${JavaScriptCore_PRIVATE_FRAMEWORK_HEADERS_DIR}/JavaScriptCore")
+target_compile_definitions(LowLevelInterpreterLib
+    PRIVATE "$<TARGET_PROPERTY:JavaScriptCore,COMPILE_DEFINITIONS>")
 add_dependencies(LowLevelInterpreterLib Bytecodes JSCBuiltins)
 if (TARGET WTF_CopyHeaders)
     add_dependencies(LowLevelInterpreterLib WTF_CopyHeaders)
diff -ruN --no-dereference sq-A/Source/JavaScriptCore/shell/CMakeLists.txt sq-B/Source/JavaScriptCore/shell/CMakeLists.txt
--- a/Source/JavaScriptCore/shell/CMakeLists.txt
+++ b/Source/JavaScriptCore/shell/CMakeLists.txt
@@ -26,6 +26,16 @@
 
 WEBKIT_EXECUTABLE_DECLARE(jsc)
 
+if (${JavaScriptCore_LIBRARY_TYPE} STREQUAL "OBJECT")
+    add_library(JavaScriptCoreShellArchive STATIC
+        $<TARGET_OBJECTS:JavaScriptCore>
+        $<TARGET_OBJECTS:LowLevelInterpreterLib>
+    )
+    list(REMOVE_ITEM jsc_FRAMEWORKS JavaScriptCore)
+    list(APPEND jsc_DEPENDENCIES JavaScriptCoreShellArchive)
+    list(PREPEND jsc_LIBRARIES "-Wl,--whole-archive" JavaScriptCoreShellArchive "-Wl,--no-whole-archive")
+endif ()
+
 if (DEVELOPER_MODE)
     set(testapi_SOURCES
         ../API/tests/CompareAndSwapTest.cpp
