# Build-system fixes for building 2.52.x on the Ubuntu 24.04 runner.
# Merged from: webkit-icu-imported-targets, webkit-jsc-llint-build-defines,
# webkit-jsc-shell-object-link.
#
# - ICU: repair the `ICU::` imported targets after find_package(ICU) so the
#   2.52 configure path works on Ubuntu 24.04.
# - LLInt: LowLevelInterpreterLib must inherit JavaScriptCore's compile
#   definitions or the object-library link fails.
# - bin/jsc: the upstream custom archive step is broken on this runner;
#   use a CMake static target linked under --whole-archive instead.
#
# Behaviour-neutral. Goes away when the host toolchain or upstream CMake
# catches up.
#
# ---
diff -ruN --no-dereference sq-A/Source/cmake/OptionsJSCOnly.cmake sq-B/Source/cmake/OptionsJSCOnly.cmake
--- a/Source/cmake/OptionsJSCOnly.cmake
+++ b/Source/cmake/OptionsJSCOnly.cmake
@@ -115,6 +115,29 @@
 endif ()
 
 find_package(ICU 70.1 REQUIRED COMPONENTS data i18n uc)
+if (ICU_FOUND)
+    foreach(_icu_component data i18n uc)
+        string(TOUPPER "${_icu_component}" _ICU_COMPONENT_UPPER)
+        set(_icu_library "${ICU_${_ICU_COMPONENT_UPPER}_LIBRARY}")
+        set(_icu_library_release "${ICU_${_ICU_COMPONENT_UPPER}_LIBRARY_RELEASE}")
+        if (TARGET ICU::${_icu_component})
+            if (_icu_library)
+                set_target_properties(ICU::${_icu_component} PROPERTIES
+                    IMPORTED_LOCATION "${_icu_library}"
+                    IMPORTED_LINK_INTERFACE_LANGUAGES "CXX"
+                )
+            endif ()
+            if (_icu_library_release)
+                set_property(TARGET ICU::${_icu_component} APPEND PROPERTY IMPORTED_CONFIGURATIONS RELEASE)
+                set_target_properties(ICU::${_icu_component} PROPERTIES
+                    IMPORTED_LOCATION_RELEASE "${_icu_library_release}"
+                    IMPORTED_LINK_INTERFACE_LANGUAGES_RELEASE "CXX"
+                )
+            endif ()
+        endif ()
+    endforeach ()
+endif ()
+
 if (APPLE)
     add_definitions(-DU_DISABLE_RENAMING=1)
 endif ()
