+// Doubles cross this boundary as NaN when an axis is unavailable, because the
+// events must report those as null rather than 0: a page reading
+// event.accelerationIncludingGravity.z == 0 as "lying flat" would otherwise be
+// told a lie by a device with no such axis.
+static inline std::optional<double> optionalFromNaN(double value)
+{
+    if (std::isnan(value))
+        return std::nullopt;
+    return value;
+}
+
+// Register @callback to be told whether anything in @web_view is listening for
+// deviceorientation/devicemotion. The embedder powers its sensors accordingly;
+// nothing is sampled for pages that never ask. Pass nullptr to unregister.
+extern "C" __attribute__((visibility("default")))
+void wpe_sfos_set_device_sensors_callback(WebKitWebView* webView, void (*callback)(gboolean orientationNeeded, gboolean motionNeeded, gpointer userData), gpointer userData)
+{
+    g_return_if_fail(WEBKIT_IS_WEB_VIEW(webView));
+
+    if (!callback) {
+        getPage(webView).setDeviceSensorsNeededHandler({ });
+        return;
+    }
+
+    getPage(webView).setDeviceSensorsNeededHandler([callback, userData](bool orientationNeeded, bool motionNeeded) {
+        callback(orientationNeeded ? TRUE : FALSE, motionNeeded ? TRUE : FALSE, userData);
+    });
+}
+
+// One deviceorientation sample. @alpha/@beta/@gamma are degrees in the W3C
+// convention; pass NAN for an axis this device cannot measure. @absolute says
+// whether the frame of reference is the Earth's (a real compass) rather than an
+// arbitrary starting orientation.
+extern "C" __attribute__((visibility("default")))
+void wpe_sfos_device_orientation_changed(WebKitWebView* webView, double alpha, double beta, double gamma, gboolean absolute)
+{
+    g_return_if_fail(WEBKIT_IS_WEB_VIEW(webView));
+
+    getPage(webView).deviceOrientationChanged(optionalFromNaN(alpha), optionalFromNaN(beta), optionalFromNaN(gamma), absolute != FALSE);
+}
+
+// One devicemotion sample. Accelerations are m/s^2, rotation rates deg/s and
+// @interval is the sampling interval in milliseconds. Pass NAN for anything
+// unavailable — in particular gravity-free acceleration, which needs a sensor
+// or a filter that not every device has.
+extern "C" __attribute__((visibility("default")))
+void wpe_sfos_device_motion_changed(WebKitWebView* webView, double x, double y, double z, double xIncludingGravity, double yIncludingGravity, double zIncludingGravity, double alphaRotationRate, double betaRotationRate, double gammaRotationRate, double interval)
+{
+    g_return_if_fail(WEBKIT_IS_WEB_VIEW(webView));
+
+    getPage(webView).deviceMotionChanged(optionalFromNaN(x), optionalFromNaN(y), optionalFromNaN(z),
+        optionalFromNaN(xIncludingGravity), optionalFromNaN(yIncludingGravity), optionalFromNaN(zIncludingGravity),
+        optionalFromNaN(alphaRotationRate), optionalFromNaN(betaRotationRate), optionalFromNaN(gammaRotationRate),
+        optionalFromNaN(interval));
+}
+#endif // ENABLE(DEVICE_ORIENTATION)
