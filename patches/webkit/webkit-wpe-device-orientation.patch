 };
 
+// SFOS: installs the DeviceOrientationController Page supplement. Upstream only
+// ever creates the controller on PLATFORM(IOS_FAMILY), where Document owns it
+// directly; on every other port LocalDOMWindow::deviceOrientationController()
+// resolves it as a Supplement<Page> that nothing provides, so it is null forever
+// and no deviceorientation event can fire. Mirrors provideGeolocationTo().
+WEBCORE_EXPORT void provideDeviceOrientationTo(Page*, DeviceOrientationClient&);
+
 } // namespace WebCore
 
 SPECIALIZE_TYPE_TRAITS_BEGIN(WebCore::DeviceOrientationController)
--- a/Source/WebCore/dom/DeviceOrientationController.cpp
+++ b/Source/WebCore/dom/DeviceOrientationController.cpp
@@ -104,4 +104,10 @@
     return m_client.get();
 }
 
+void provideDeviceOrientationTo(Page* page, DeviceOrientationClient& client)
+{
+    ASSERT(page);
+    Supplement<Page>::provideTo(page, DeviceOrientationController::supplementName(), makeUnique<DeviceOrientationController>(client));
+}
+
