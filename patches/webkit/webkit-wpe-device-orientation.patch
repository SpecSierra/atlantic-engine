+void WebPage::deviceMotionChanged(std::optional<double> x, std::optional<double> y, std::optional<double> z, std::optional<double> xIncludingGravity, std::optional<double> yIncludingGravity, std::optional<double> zIncludingGravity, std::optional<double> alphaRotationRate, std::optional<double> betaRotationRate, std::optional<double> gammaRotationRate, std::optional<double> interval)
+{
+    if (!m_deviceMotionClient)
+        return;
+
+    Ref data = WebCore::DeviceMotionData::create(
+        WebCore::DeviceMotionData::Acceleration::create(x, y, z),
+        WebCore::DeviceMotionData::Acceleration::create(xIncludingGravity, yIncludingGravity, zIncludingGravity),
+        WebCore::DeviceMotionData::RotationRate::create(alphaRotationRate, betaRotationRate, gammaRotationRate),
+        interval);
+    m_deviceMotionClient->motionChanged(data.get());
+}
+
+void WebPage::updateDeviceSensorsNeeded()
+{
+    bool orientationNeeded = m_deviceOrientationClient && m_deviceOrientationClient->isUpdating();
+    bool motionNeeded = m_deviceMotionClient && m_deviceMotionClient->isUpdating();
+    if (orientationNeeded == m_deviceOrientationNeeded && motionNeeded == m_deviceMotionNeeded)
+        return;
+
+    m_deviceOrientationNeeded = orientationNeeded;
+    m_deviceMotionNeeded = motionNeeded;
+    send(Messages::WebPageProxy::SetDeviceSensorsNeeded(orientationNeeded, motionNeeded));
+}
