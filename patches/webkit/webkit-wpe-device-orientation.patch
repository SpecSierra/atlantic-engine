 namespace WebKit {
+
+#if ENABLE(DEVICE_ORIENTATION)
+// SFOS: WebProcess-side DeviceOrientation/DeviceMotion clients.
+//
+// Upstream's clients for this are DeviceOrientationClientIOS /
+// DeviceMotionClientIOS, which the WPE tarball does not ship (Apple strips
+// PLATFORM(IOS_FAMILY) sources), along with everything
+// WebDeviceOrientationUpdateProvider depends on — so there is nothing to reuse
+// and these are written from the WebCore interfaces directly.
+//
+// They are deliberately passive: they hold the most recent sample so that
+// DeviceController::getLastEvent() can answer a newly-registered listener
+// immediately, and they record whether WebCore currently wants updates. The
+// sensors themselves live in the UI process (QtSensors -> sensorfw), which is
+// where samples are pushed in from; the WebProcess never touches the sensor
+// stack, exactly as it does not touch the positioning stack for geolocation.
+//
+// NOTE: startUpdating()/stopUpdating() are what should power the sensors on and
+// off. Until the UI-process notification lands they only record the state, so a
+// page that never listens still costs nothing here, but the embedder has no way
+// to know it can stop sampling. That message is the next step.
+class WebDeviceOrientationClient final : public WebCore::DeviceOrientationClient {
+public:
+    explicit WebDeviceOrientationClient(WebPage& page)
+        : m_page(page)
+    {
+    }
+
+    void setController(WebCore::DeviceOrientationController* controller) final { m_controller = controller; }
+    WebCore::DeviceOrientationData* lastOrientation() const final { return m_lastOrientation.get(); }
+
+    // The controller holds only a WeakRef and this client is owned by WebPage,
+    // so there is nothing to destroy here. (Deleting self would be wrong: the
+    // WTF_OVERRIDE_DELETE_FOR_CHECKED_PTR destroying-delete on the base is
+    // declared for the base type and asserts on the exact object size.)
+    void deviceOrientationControllerDestroyed() final { m_controller = nullptr; }
+
+    void startUpdating() final { m_updating = true; }
+    void stopUpdating() final { m_updating = false; }
+    bool isUpdating() const { return m_updating; }
+
+    void orientationChanged(WebCore::DeviceOrientationData& data)
+    {
+        m_lastOrientation = &data;
+        if (m_controller)
+            m_controller->didChangeDeviceOrientation(m_lastOrientation.get());
+    }
+
+private:
+    WeakRef<WebPage> m_page;
+    CheckedPtr<WebCore::DeviceOrientationController> m_controller;
+    RefPtr<WebCore::DeviceOrientationData> m_lastOrientation;
+    bool m_updating { false };
+};
+
+class WebDeviceMotionClient final : public WebCore::DeviceMotionClient {
+public:
+    explicit WebDeviceMotionClient(WebPage& page)
+        : m_page(page)
+    {
+    }
+
+    void setController(WebCore::DeviceMotionController* controller) final { m_controller = controller; }
+    WebCore::DeviceMotionData* lastMotion() const final { return m_lastMotion.get(); }
+    void deviceMotionControllerDestroyed() final { m_controller = nullptr; }
+
+    void startUpdating() final { m_updating = true; }
+    void stopUpdating() final { m_updating = false; }
+    bool isUpdating() const { return m_updating; }
+
+    void motionChanged(WebCore::DeviceMotionData& data)
+    {
+        m_lastMotion = &data;
+        if (m_controller)
+            m_controller->didChangeDeviceMotion(m_lastMotion.get());
+    }
+
+private:
+    WeakRef<WebPage> m_page;
+    CheckedPtr<WebCore::DeviceMotionController> m_controller;
+    RefPtr<WebCore::DeviceMotionData> m_lastMotion;
+    bool m_updating { false };
+};
+#endif // ENABLE(DEVICE_ORIENTATION)
