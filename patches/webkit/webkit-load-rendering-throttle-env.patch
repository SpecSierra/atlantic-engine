+// Cap the rendering-update rate while the page is loading (WEBKIT_LOAD_RENDERING_INTERVAL_MS,
+// unset/0 = off). A heavy load re-lays-out and repaints the page dozens of times as scripts,
+// stylesheets and images land; batching rendering updates to this interval coalesces those
+// passes without changing what gets invalidated.
+static Seconds loadRenderingThrottleInterval()
+{
+    static Seconds interval = [] {
+        const char* v = getenv("WEBKIT_LOAD_RENDERING_INTERVAL_MS");
+        int ms = v ? atoi(v) : 0;
+        return Seconds::fromMilliseconds(std::max(ms, 0));
+    }();
+    return interval;
+}
+
+void Page::setRenderingThrottledForLoad(bool throttled)
+{
+    if (loadRenderingThrottleInterval() <= 0_s)
+        return;
+
+    if (m_renderingThrottledForLoad == throttled)
+        return;
+
+    m_renderingThrottledForLoad = throttled;
+    if (CheckedPtr scheduler = existingRenderingUpdateScheduler())
+        scheduler->adjustRenderingUpdateFrequency();
+    chrome().client().renderingUpdateFramesPerSecondChanged();
+}
