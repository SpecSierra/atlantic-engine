# Black tiles on the Jolla Phone 2 are a stale first composite, not lost paint.
#
# Build 754, readback off: a black band heals as soon as anything makes the
# compositor draw again, with no tile repainted (a short touch scroll; a small
# animated element). So the tile texture holds the right content; the first
# composite that samples it, from another GL context a few ms after the paint,
# gets black, and at rest nothing composites again. Between the tile's flush and
# its surface release: raw glReadPixels of its framebuffer cures (0/6), keeping
# the surface alive does not (5/6), nor glFlush (6/6), nor glFinish (6/6).
#
# WEBKIT_TILE_GPU_RECOMPOSITE=N (experiment, default 0, max 8) composites N more
# frames after one that took a GPU-painted tile update, as a replacement for the
# per-tile readback (WEBKIT_TILE_GPU_READBACK_SYNC), which gdb put at 38% of the
# compositor's busy samples during a scroll with repaints.
#
# ---
--- a/Source/WebCore/platform/graphics/texmap/coordinated/CoordinatedBackingStoreTile.cpp
+++ b/Source/WebCore/platform/graphics/texmap/coordinated/CoordinatedBackingStoreTile.cpp
@@ -26,6 +26,7 @@
 #include "CoordinatedTileBuffer.h"
 #include "GraphicsLayer.h"
 #include <atomic>
+#include <algorithm>
 #include <cstdlib>
 #include <cstring>
 #include <ctime>
@@ -271,6 +272,44 @@
     s_deferredThisFrame = true;
 }
 
+// WEBKIT_TILE_GPU_RECOMPOSITE=N (experiment, default 0, max 8).
+//
+// The "black tiles" on the Jolla Phone 2 (Mali-G610) are not lost paint. With
+// the readback off a black band heals as soon as anything makes the compositor
+// draw again, with no tile repainted (a short touch scroll, or a small animated
+// element; build 754). The tile texture holds the right content, but the first
+// composite that samples it, in another GL context a few ms after the paint,
+// gets black, and at rest no further composite comes to correct it. A glFinish
+// in the painting context does not prevent that; reading the tile framebuffer
+// back does, which is what WEBKIT_TILE_GPU_READBACK_SYNC pays for on every tile.
+// This composites N more frames after one that took a GPU tile update instead.
+static unsigned gpuRecompositeFrames()
+{
+    static const unsigned frames = [] {
+        const char* env = getenv("WEBKIT_TILE_GPU_RECOMPOSITE");
+        int value = env ? atoi(env) : 0;
+        return static_cast<unsigned>(std::clamp(value, 0, 8));
+    }();
+    return frames;
+}
+
+// Compositor-thread only, like the statics above.
+static unsigned s_gpuRecompositeFramesLeft = 0;
+
+void noteGpuTileUpdate()
+{
+    if (auto frames = gpuRecompositeFrames())
+        s_gpuRecompositeFramesLeft = frames;
+}
+
+bool takeGpuRecompositeFrame()
+{
+    if (!s_gpuRecompositeFramesLeft)
+        return false;
+    --s_gpuRecompositeFramesLeft;
+    return true;
+}
+
 } // namespace TileUploadBudget
 
