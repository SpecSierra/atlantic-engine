+// ── Tile raster cost tracking ────────────────────────────────────────────────
+// The scroll-degradation ladder (low-res tiles / checkerboard) currently decides
+// whether to degrade from scroll SPEED alone. Speed is a geometry term: it says
+// how many tiles are being exposed per second, but nothing about what a tile
+// COSTS to rasterize -- and cost varies by more than an order of magnitude
+// between a flat-background article and a page of gradients and shadows. On
+// build 618 that blindness makes the same knob worth -38% p95 frame time on a
+// raster-bound page and +5.7% p95 / +11% raster CPU on a cheap one.
+//
+// This tracks the missing term: an exponentially-weighted moving average of
+// raster cost in NANOSECONDS PER PAINTED PIXEL, measured where the work actually
+// happens. Per-painted-pixel (rather than per-tile) makes the figure independent
+// of tile size and of the low-res scale currently in effect, so a full-res
+// prediction is just nsPerPixel x fullResTileArea and the estimator does not
+// drift as the controller changes the scale underneath it.
+//
+// Thread safety: raster runs on SkiaCPUWorker/SkiaGPUWorker threads or the
+// compositor thread, while the eventual consumer (the tier decision) runs on the
+// main thread. A relaxed atomic is deliberate -- this is a smoothed statistic, a
+// torn or slightly stale read costs nothing, and a lock on the raster hot path
+// would cost more than the signal is worth.
+class TileRasterCost {
+public:
+    static TileRasterCost& singleton()
+    {
+        static NeverDestroyed<TileRasterCost> instance;
+        return instance.get();
+    }
+
+    void record(Seconds elapsed, const IntSize& bufferSize)
+    {
+        auto pixels = static_cast<double>(bufferSize.width()) * bufferSize.height();
+        if (pixels <= 0)
+            return;
+        double nsPerPixel = elapsed.nanoseconds() / pixels;
+        // Guard against absurd samples (a thread descheduled mid-raster measures
+        // wall time, not work). Anything past 10 us/px is scheduling noise.
+        if (!std::isfinite(nsPerPixel) || nsPerPixel <= 0 || nsPerPixel > 10000)
+            return;
+
+        double previous = m_nsPerPixel.load(std::memory_order_relaxed);
+        // Seed on the first sample so the average does not crawl up from zero.
+        double updated = previous > 0 ? (previous * (1.0 - s_alpha) + nsPerPixel * s_alpha)
+                                      : nsPerPixel;
+        m_nsPerPixel.store(updated, std::memory_order_relaxed);
+        m_samples.fetch_add(1, std::memory_order_relaxed);
+
+        if (loggingEnabled()) {
+            auto n = m_samples.load(std::memory_order_relaxed);
+            // Throttled: one line per 32 tiles, else a fling floods the log and
+            // the logging itself perturbs what is being measured.
+            if (!(n % 32)) {
+                fprintf(stderr, "[tilecost] buf=%dx%d px=%.0f ms=%.2f ns/px=%.1f "
+                    "ewma=%.1f n=%u\n", bufferSize.width(), bufferSize.height(),
+                    pixels, elapsed.milliseconds(), nsPerPixel, updated, n);
+            }
+        }
+    }
+
+    // Nanoseconds per painted pixel; 0 until the first sample lands.
+    double nsPerPixel() const { return m_nsPerPixel.load(std::memory_order_relaxed); }
+    unsigned sampleCount() const { return m_samples.load(std::memory_order_relaxed); }
+
+    // Predicted cost, in milliseconds, of rasterizing `pixels` at full resolution.
+    double predictedMsForPixels(double pixels) const
+    {
+        double ns = nsPerPixel();
+        return ns > 0 ? (ns * pixels) / 1e6 : 0.0;
+    }
+
+    static bool loggingEnabled()
+    {
+        static bool enabled = [] {
+            const char* env = getenv("WEBKIT_TILECOST_LOG");
+            return env && *env && strcmp(env, "0");
+        }();
+        return enabled;
+    }
+
+private:
+    friend class NeverDestroyed<TileRasterCost>;
+    TileRasterCost() = default;
+
+    // Fast enough to track a page transition within a fling, slow enough that a
+    // single descheduled tile cannot swing the trigger.
+    static constexpr double s_alpha = 0.12;
+
+    std::atomic<double> m_nsPerPixel { 0.0 };
+    std::atomic<unsigned> m_samples { 0 };
+};
+
+double SkiaPaintingEngine::tileRasterNsPerPixel()
+{
+    return TileRasterCost::singleton().nsPerPixel();
+}
+
+unsigned SkiaPaintingEngine::tileRasterSampleCount()
+{
+    return TileRasterCost::singleton().sampleCount();
+}
+
+double SkiaPaintingEngine::predictedTileRasterMs(double fullResPixels)
+{
+    return TileRasterCost::singleton().predictedMsForPixels(fullResPixels);
+}
