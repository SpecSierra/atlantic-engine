     // against stale position:fixed/sticky layer positions. This also
     // overwrites stale positions committed by a desynchronized main thread.
-    if (compositeScrollSyncEnabled()) {
+    // Only composites that consume Position/BoundsOrigin changes
+    // (RenderingUpdate/AsyncScrolling) need — or may — re-apply scroll
+    // positions; VideoFrame/Animation-only composites leave them pending.
+    if (compositeScrollSyncEnabled() && reasons.containsAny({ CompositionReason::RenderingUpdate, CompositionReason::AsyncScrolling })) {
         RefPtr<WebCore::ScrollingTree> scrollingTree;
         {
             Locker locker { m_scrollingTreeLock };
