 WTF_MAKE_TZONE_ALLOCATED_IMPL(LayerTreeHost);
 
+// See webkit-load-rendering-throttle-env.patch: cap rendering-update cadence while
+// the main load is in progress. On this port rendering updates are driven by the
+// LayerTreeHost run-loop observer (the WebCore RenderingUpdateScheduler/DisplayLink
+// machinery is bypassed), so the throttle must live here.
+static Seconds loadRenderingThrottleInterval()
+{
+    static Seconds interval = [] {
+        const char* v = getenv("WEBKIT_LOAD_RENDERING_INTERVAL_MS");
+        int ms = v ? atoi(v) : 0;
+        return Seconds::fromMilliseconds(std::max(ms, 0));
+    }();
+    return interval;
+}
+
 LayerTreeHost::LayerTreeHost(WebPage& webPage)
     : m_webPage(webPage)
     , m_sceneState(CoordinatedSceneState::create())
+    , m_loadThrottledRenderingUpdateTimer(*this, &LayerTreeHost::loadThrottledRenderingUpdateTimerFired)
 #if USE(CAIRO)
     , m_paintingEngine(Cairo::PaintingEngine::create())
 #elif USE(SKIA)
@@ -164,9 +181,27 @@
         return;
     }
 
+    if (auto throttleInterval = loadRenderingThrottleInterval(); throttleInterval > 0_s) {
+        auto* corePage = m_webPage.corePage();
+        if (corePage && corePage->isRenderingThrottledForLoad()) {
+            auto now = MonotonicTime::now();
+            auto nextUpdateTime = m_lastRenderingUpdateTime + throttleInterval;
+            if (now < nextUpdateTime) {
+                if (!m_loadThrottledRenderingUpdateTimer.isActive())
+                    m_loadThrottledRenderingUpdateTimer.startOneShot(nextUpdateTime - now);
+                return;
+            }
+        }
+    }
+
     scheduleRenderingUpdateRunLoopObserver();
 }
 
+void LayerTreeHost::loadThrottledRenderingUpdateTimerFired()
+{
+    scheduleRenderingUpdate();
+}
