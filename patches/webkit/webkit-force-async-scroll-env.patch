+// WEBKIT_FORCE_ASYNC_SCROLL: never fall back to main-thread ("synchronous")
+// scrolling because of slow-repaint content. Pages with a non-composited
+// position:fixed/sticky element (HasNonLayerViewportConstrainedObjects) or
+// slow-repaint objects like background-attachment:fixed (HasSlowRepaintObjects)
+// normally force EVERY scroll frame to wait for a full main-thread rendering
+// update; on main-thread-bound pages (franceinfo: ~1s per update) that means
+// scrolling at ~1fps. With this set, those reasons are ignored so the scrolling
+// thread keeps applying layer positions and compositing at full rate.
+// Deliberately lossy: the affected fixed/sticky elements are repositioned only
+// at main-thread cadence (they visibly lag/jitter during the scroll), and fixed
+// backgrounds can shift. Structural reasons (ForcedOnMainThread, IsImageDocument,
+// HasViewportConstrainedObjectsWithoutSupportingFixedLayers) are preserved.
+static bool forceAsyncScrollEnabled()
+{
+    static bool enabled = [] {
+        const char* env = getenv("WEBKIT_FORCE_ASYNC_SCROLL");
+        return env && *env && strcmp(env, "0");
+    }();
+    return enabled;
+}
