 #if HAVE(DISPLAY_LINK)
+// WEBKIT_INDEPENDENT_SCROLL (see ThreadedScrollingTree.cpp for the scheduling
+// half): give the scrolling thread a display-link observer of its own.
+//
+// The scrolling thread's only heartbeat is displayDidRefresh: it is what drives
+// displayDidRefreshOnScrollingThread -> applyLayerPositions ->
+// requestComposition(AsyncScrolling). On this port that heartbeat is owned by the
+// main thread, which makes "independent" scrolling impossible by construction:
+//
+//   - The only display-link observer ever registered is the main thread's
+//     WebDisplayRefreshMonitor (its startNotificationMechanism is driven by
+//     DisplayRefreshMonitorManager::scheduleAnimation). EventDispatcher already
+//     has startDisplayDidRefreshCallbacks(), but it is called only by
+//     MomentumEventDispatcher, which is not ENABLE()d for WPE -- dead code here.
+//   - DisplayRefreshMonitor::displayLinkFired() drops the tick outright while
+//     !isPreviousFrameDone(), and stops the notification mechanism after a single
+//     unscheduled fire (m_maxUnscheduledFireCount is 0).
+//   - DisplayLink::notifyObserversDisplayDidRefresh() skips any client whose
+//     observer list is empty, and DisplayLinkProcessProxyClient only sends
+//     EventDispatcher::DisplayDidRefresh (the scrolling-thread path) when the
+//     client wants full-speed updates.
+//
+// So a main thread that stalls -- franceinfo, m_isWaitingForRenderer stuck --
+// stops scheduling animations, its observer is removed, the display link goes
+// quiet, and the scrolling thread simply stops ticking. Device-measured: scroll
+// composites (ftrace reqcomp r=8) at 7.3/s and scrollapply at ~11/s instead of
+// 60, with 1.3s gaps, while the compositor thread sat ~84% idle. The vblank
+// source itself is fine (even the timer fallback is 60fps) -- it is the observer
+// bookkeeping that dies with the main thread.
+//
+// Registering our own observer for the duration of scroll activity keeps the
+// client's observer list non-empty and the link alive independently of the main
+// thread. We hold it while the scrolling tree reports recent activity
+// (ScrollingTree::hasRecentActivity(): wheel events within 50ms, or a running
+// scroll animation) and drop it as soon as scrolling settles, so an idle page
+// costs nothing.
+void EventDispatcher::ensureScrollingDisplayLink(PlatformDisplayID displayID)
+{
+    if (m_scrollingDisplayLinkID && *m_scrollingDisplayLinkID == displayID)
+        return;
+
+    if (m_scrollingDisplayLinkID)
+        stopScrollingDisplayLink();
+
+    WebProcess::singleton().protectedParentProcessConnection()->send(Messages::WebProcessProxy::StartDisplayLink(m_scrollingObserverID, displayID, WebCore::FullSpeedFramesPerSecond), 0);
+    m_scrollingDisplayLinkID = displayID;
+}
+
+void EventDispatcher::stopScrollingDisplayLink()
+{
+    if (!m_scrollingDisplayLinkID)
+        return;
+
+    WebProcess::singleton().protectedParentProcessConnection()->send(Messages::WebProcessProxy::StopDisplayLink(m_scrollingObserverID, *m_scrollingDisplayLinkID), 0);
+    m_scrollingDisplayLinkID = std::nullopt;
+}
+#endif
