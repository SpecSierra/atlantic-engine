#  webkit-composite-skip-locked-layers-env.patch: WEBKIT_COMPOSITE_SKIP_LOCKED_-
#  LAYERS=1 (default OFF) — the video fast path. CoordinatedPlatformLayer::
#  flushCompositingState() (compositor thread) blocks on the per-layer m_lock
#  that the MAIN thread holds across updateBackingStore() ->
#  CoordinatedBackingStoreProxy::updateIfNeeded(), i.e. across a full-viewport
#  tile update. Device-measured on fullscreen 1080p YouTube (build 606, root
#  /proc/<tid>/syscall sampling at 20 ms correlated with ATLANTIC_FRAME_TRACE):
#  in 5 of 7 stalls the compositor sits in futex_wait (syscall 98, 15-25
#  consecutive samples, kstack futex_wait_queue_me/futex_wait/do_futex) for the
#  whole 230-800 ms stall while the main thread runs at 100 %; video frames are
#  requested on time throughout (reqcomp r=2 every 40.0 ms) and cannot be
#  presented. With this on, a composite carrying no RenderingUpdate
#  (VideoFrame/Animation/AsyncScrolling/TileDrain) tryLock()s each layer and
#  skips the contended ones, re-presenting their last committed state; their
#  pending changes stay pending for the next composite. RenderingUpdate
#  composites still block, deliberately — they must commit and report the flush.
#  Lossy the same way the tile-upload budget is (a stale layer for a frame or
#  two instead of a frozen scene). Unset/0 = stock. Must apply AFTER every other
#  patch touching CoordinatedPlatformLayer.cpp (lowres-tiles-during-scroll,
#  tile-upload-budget, drop-tiles-when-hidden).
#  NOTE: this is the SECOND theory for these stalls; the first
#  (webkit-video-composite-tile-gate-env, the Idle-branch tile gate) was
#  disproven on device by its own schedupd marker (wt=0). Verify with a 5x5 A/B
#  before flipping the default, and see INVESTIGATION.md for the levers already
#  ruled out.
#  2.54 rebase: the compositor now also takes m_lock in flushPositionChanges()
#  and in hasPendingBackingStoreTileUpdates()/processPendingBackingStoreTile-
#  Updates(), the tile-drain pair CoordinatedSceneState runs for EVERY layer on
#  EVERY composite (VideoFrame included). Guarding only flushCompositingState()
#  would have silently reintroduced the judder, so all four sites tryLock. The
#  drain pair has no reasons argument and skips even in RenderingUpdate
#  composites; that is safe because a contended lock means the main thread is
#  mid-update and will request another composite, and the store keeps its
#  pending flag. RE-MEASURE the 1080p fullscreen A/B on 2.54 before trusting it.
#
# ---
diff --git a/Source/WebCore/platform/graphics/texmap/coordinated/CoordinatedPlatformLayer.cpp b/Source/WebCore/platform/graphics/texmap/coordinated/CoordinatedPlatformLayer.cpp
--- a/Source/WebCore/platform/graphics/texmap/coordinated/CoordinatedPlatformLayer.cpp
+++ b/Source/WebCore/platform/graphics/texmap/coordinated/CoordinatedPlatformLayer.cpp
@@ -31,6 +31,7 @@
 #include "CoordinatedBackingStore.h"
 #include "CoordinatedBackingStoreProxy.h"
 #include <cstdio>
+#include <cstdlib>
 #include "CoordinatedImageBackingStore.h"
 #include "CoordinatedPlatformLayerBuffer.h"
 #include "CoordinatedPlatformLayerBufferHolePunch.h"
@@ -49,6 +50,18 @@
 
 namespace WebCore {
 
+// WEBKIT_COMPOSITE_SKIP_LOCKED_LAYERS=1 (default OFF): don't let a composite that
+// does not carry a RenderingUpdate block on a layer lock the main thread holds.
+// See flushCompositingState() below.
+static bool atlSkipLockedLayers()
+{
+    static const bool on = [] {
+        const char* e = getenv("WEBKIT_COMPOSITE_SKIP_LOCKED_LAYERS");
+        return e && e[0] && e[0] != '0';
+    }();
+    return on;
+}
+
 Ref<CoordinatedPlatformLayer> CoordinatedPlatformLayer::create(Client& client)
 {
     return adoptRef(*new CoordinatedPlatformLayer(&client));
@@ -1034,7 +1047,15 @@ void CoordinatedPlatformLayer::flushPositionChanges(const OptionSet<CompositionR
     if (!reasons.containsAny({ CompositionReason::RenderingUpdate, CompositionReason::AsyncScrolling }))
         return;
 
-    Locker locker { m_lock };
+    // WEBKIT_COMPOSITE_SKIP_LOCKED_LAYERS: an AsyncScrolling-only composite does
+    // not wait for a layer the main thread holds; its position change stays
+    // pending (see flushCompositingState()).
+    if (atlSkipLockedLayers() && !reasons.contains(CompositionReason::RenderingUpdate)) {
+        if (!m_lock.tryLock())
+            return;
+    } else
+        m_lock.lock();
+    Locker locker { AdoptLock, m_lock };
     if (!m_pendingChanges.containsAny({ Change::Position, Change::BoundsOrigin }))
         return;
 
@@ -1066,7 +1087,41 @@ void CoordinatedPlatformLayer::flushPositionChanges(const OptionSet<CompositionR
 void CoordinatedPlatformLayer::flushCompositingState(const OptionSet<CompositionReason>& reasons, bool useSkiaTarget)
 {
     ASSERT(!isMainThread());
-    Locker locker { m_lock };
+    // Video fast path (WEBKIT_COMPOSITE_SKIP_LOCKED_LAYERS=1, default OFF).
+    //
+    // Device-measured on fullscreen 1080p YouTube (build 606): the compositor
+    // spends the whole of each 230-800 ms stall in futex_wait (syscall 98, 15-25
+    // consecutive 20 ms samples, kernel stack futex_wait_queue_me/futex_wait/
+    // do_futex) while the main thread runs at 100 %. It is blocked here, on
+    // m_lock, which the main thread holds across updateBackingStore() ->
+    // CoordinatedBackingStoreProxy::updateIfNeeded() -- i.e. across a
+    // full-viewport tile update. Video frames are ready and requested on time
+    // (reqcomp r=2 every 40.0 ms) and simply cannot be presented meanwhile, which
+    // is the fullscreen judder.
+    //
+    // A composite that carries no RenderingUpdate (VideoFrame / Animation /
+    // AsyncScrolling / TileDrain) does not have to commit this layer's pending
+    // changes: it may re-present the last committed state. So take the lock only
+    // if it is free, and otherwise leave the layer exactly as it is -- the
+    // pending changes stay pending and the next composite (or the RenderingUpdate
+    // that follows) applies them. Lossy in the same way the tile-upload budget
+    // is: a contended layer shows its previous state for a frame or two instead
+    // of freezing the whole scene, video included.
+    //
+    // A RenderingUpdate composite still blocks, deliberately: it is the one that
+    // must commit the flush and report it, so skipping layers there would tell
+    // the main thread its update landed when it did not.
+    //
+    // 2.54: the compositor also takes m_lock in flushPositionChanges() and in the
+    // tile-drain pair hasPendingBackingStoreTileUpdates() /
+    // processPendingBackingStoreTileUpdates(), the latter on EVERY composite for
+    // every layer; all three follow the same rule (see those functions).
+    if (atlSkipLockedLayers() && !reasons.contains(CompositionReason::RenderingUpdate)) {
+        if (!m_lock.tryLock())
+            return;
+    } else
+        m_lock.lock();
+    Locker locker { AdoptLock, m_lock };
     if (m_pendingChanges.isEmpty() && (!reasons.contains(CompositionReason::RenderingUpdate) || !m_backingStoreProxy))
         return;
 
@@ -1469,7 +1524,17 @@ bool CoordinatedPlatformLayer::hasPendingBackingStoreTileUpdates() const
         return m_skiaTarget->hasPendingBackingStoreTileUpdates();
 #endif
 
-    Locker locker { m_lock };
+    // WEBKIT_COMPOSITE_SKIP_LOCKED_LAYERS: called for every layer on every
+    // composite, so it must not block on a layer the main thread holds (see
+    // flushCompositingState()). A contended lock means the main thread is mid
+    // rendering update and will request a RenderingUpdate composite when done;
+    // the store keeps its pending flag, so the drain just moves to that frame.
+    if (atlSkipLockedLayers()) {
+        if (!m_lock.tryLock())
+            return false;
+    } else
+        m_lock.lock();
+    Locker locker { AdoptLock, m_lock };
     if (m_backingStore)
         return m_backingStore->hasPendingUpdates();
 
@@ -1487,7 +1552,14 @@ void CoordinatedPlatformLayer::processPendingBackingStoreTileUpdates()
     }
 #endif
 
-    Locker locker { m_lock };
+    // Same rule as hasPendingBackingStoreTileUpdates(): the lock may have been
+    // taken by the main thread since that check.
+    if (atlSkipLockedLayers()) {
+        if (!m_lock.tryLock())
+            return;
+    } else
+        m_lock.lock();
+    Locker locker { AdoptLock, m_lock };
     if (m_backingStore)
         m_backingStore->processPendingUpdates();
 }
