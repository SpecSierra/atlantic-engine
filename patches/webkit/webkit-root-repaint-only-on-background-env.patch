         // the canvas. Issue full repaint, when our style changes substantially.
         if (diff >= Style::DifferenceResult::Repaint && (isDocumentElementRenderer() || isBody())) {
-            view().repaintRootContents();
-            if (Style::hasEntirelyFixedBackground(oldStyle->backgroundLayers()) != Style::hasEntirelyFixedBackground(newStyle.backgroundLayers()))
-                view().compositor().rootLayerConfigurationChanged();
+            // Atlantic (WEBKIT_SKIP_ROOT_REPAINT_UNLESS_BACKGROUND, default on):
+            // repaintRootContents() repaints the ENTIRE root layer (franceinfo: a
+            // 29883-93000px tall layer). Per the comment above, it exists ONLY because the
+            // root/body BACKGROUND propagates up to the canvas - a background change on
+            // <html>/<body> must repaint the whole canvas. Any OTHER style change on the
+            // root/body (a class toggle for nav/menu state, a CSS custom property such as
+            // franceinfo's --offset-sticky-*) does NOT paint the canvas: the elements whose
+            // rendering actually changed are repainted by the normal renderer-level repaint
+            // path. Yet WebKit conservatively repaints the whole page for all of them.
+            //
+            // Device-proven (ATLANTIC_REPAINT_BT backtraces): on franceinfo this fires on
+            // ~every scroll frame (custom-property writes) AND repeatedly while the page
+            // merely settles (class toggles) - the visible "icons blinking several times
+            // before settling", and ~2280 tile repaints per scroll update that lock-step the
+            // compositor into a multi-second freeze.
+            //
+            // So: only take the full-page repaint when the background actually changed -
+            // its color (which propagates to the canvas) or its layers (images/position).
+            static const bool skipUnlessBackground = [] {
+                const char* e = getenv("WEBKIT_SKIP_ROOT_REPAINT_UNLESS_BACKGROUND");
+                return !e || !e[0] || e[0] != '0'; // default ON; =0 restores stock
+            }();
+            const bool backgroundMayHaveChanged = oldStyle->hasBackground() != newStyle.hasBackground()
+                || oldStyle->visitedDependentBackgroundColor() != newStyle.visitedDependentBackgroundColor()
+                || !(oldStyle->backgroundLayers() == newStyle.backgroundLayers());
+            if (!skipUnlessBackground || backgroundMayHaveChanged) {
+                view().repaintRootContents();
+                if (Style::hasEntirelyFixedBackground(oldStyle->backgroundLayers()) != Style::hasEntirelyFixedBackground(newStyle.backgroundLayers()))
+                    view().compositor().rootLayerConfigurationChanged();
+            }
         }
         
