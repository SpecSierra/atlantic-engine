 } // namespace WebKit
+
+// SFOS: runtime dark-mode switch for the legacy (libwpe) WPE API, which has no
+// platform settings backend (darkMode() above is hardwired to false). The
+// embedder calls this from the UI-process main thread; it updates the global
+// SystemSettings (source of truth for PageClientImpl::effectiveAppearanceIsDark
+// and new web-process creation parameters), notifies the web processes, and the
+// per-view SystemSettings observers push the new appearance to live pages.
+extern "C" __attribute__((visibility("default")))
+void wpe_sfos_set_dark_mode(int darkMode)
+{
+    WebCore::SystemSettings::State changedState;
+    changedState.darkMode = !!darkMode;
+    for (auto& processPool : WebKit::WebProcessPool::allProcessPools())
+        processPool->sendToAllProcesses(Messages::SystemSettingsManager::DidChange(changedState));
+    WebCore::SystemSettings::singleton().updateSettings(changedState);
+}
