+bool TextureMapperLayer::subtreeIntersectsRect(const FloatRect& surfaceRect) const
+{
+    if (!m_state.size.isEmpty() && m_layerTransforms.combined.mapRect(layerRect()).intersects(surfaceRect))
+        return true;
+
+    return std::ranges::any_of(m_children,
+        [&](TextureMapperLayer* child) {
+            return child->subtreeIntersectsRect(surfaceRect);
+        });
+}
+
+bool TextureMapperLayer::runningAnimationsIntersectRect(const FloatRect& surfaceRect) const
+{
+    if (m_animations.hasRunningAnimations()) {
+        // A replica draws the layer a second time somewhere else; do not try to
+        // work out where.
+        if (m_state.replicaLayer || subtreeIntersectsRect(surfaceRect))
+            return true;
+    }
+
+    if (m_state.replicaLayer && m_state.replicaLayer->runningAnimationsIntersectRect(surfaceRect))
+        return true;
+    if (m_state.backdropLayer && m_state.backdropLayer->m_animations.hasRunningAnimations() && subtreeIntersectsRect(surfaceRect))
+        return true;
+
+    return std::ranges::any_of(m_children,
+        [&](TextureMapperLayer* child) {
+            return child->runningAnimationsIntersectRect(surfaceRect);
+        });
+}
