+
+// WEBKIT_OFFSCREEN_ANIMATION_INTERVAL_MS (default 0 = upstream): how often to
+// composite when the only reason is an animation none of whose layers is on
+// the surface. Upstream composites at the full frame rate for as long as any
+// animation runs anywhere in the layer tree, so one infinite CSS animation
+// scrolled out of view (a "live" dot in a page header) keeps the compositor,
+// the GPU and the embedder's present loop at 60-90 fps on an idle page. The
+// animation still advances — every composite samples it at the current time —
+// and a layer that moves onto the surface is noticed at the next tick.
+static Seconds offscreenAnimationInterval()
+{
+    static const Seconds interval = [] {
+        const char* env = getenv("WEBKIT_OFFSCREEN_ANIMATION_INTERVAL_MS");
+        int milliseconds = env ? atoi(env) : 0;
+        return Seconds::fromMilliseconds(std::clamp(milliseconds, 0, 1000));
+    }();
+    return interval;
+}
+
+void ThreadedCompositor::requestAnimationComposition(bool animatedContentOnSurface)
+{
+    ASSERT(m_workQueue->runLoop().isCurrent());
+    auto interval = offscreenAnimationInterval();
+    if (animatedContentOnSurface || !interval) {
+        m_offscreenAnimationTimer.stop();
         requestComposition(CompositionReason::Animation);
+        return;
+    }
+
+    if (atlFrameTrace() && !m_offscreenAnimationTimer.isActive())
+        fprintf(stderr, "[ftrace] web anim-offscreen wait=%.0fms\n", interval.milliseconds());
+    if (!m_offscreenAnimationTimer.isActive())
+        m_offscreenAnimationTimer.startOneShot(interval);
+}
+
+void ThreadedCompositor::offscreenAnimationTimerFired()
+{
+    requestComposition(CompositionReason::Animation);
 }
 
 #if ENABLE(DAMAGE_TRACKING)
