# webkit-offscreen-animation-throttle-env.patch: stop compositing at full frame
# rate for an animation nobody can see.
#
# The compositor re-requests a frame for as long as ANY animation runs anywhere
# in the layer tree, visible or not. One infinite CSS animation scrolled out of
# view is enough: Wikipedia's mobile pages carry a pulsating dot in the header,
# so a page scrolled past it keeps compositing ~90 frames a second while idle —
# compositor thread, GPU and the embedder's present loop all busy for nothing.
#
# WEBKIT_OFFSCREEN_ANIMATION_INTERVAL_MS=<ms> (default 0 = upstream, max 1000):
# when a frame's only pending reason is an animation and no animated layer (nor
# anything in its subtree, now or ~50 ms ahead) intersects the surface, the
# next animation frame waits that long instead of being requested at once.
# 100 gives 10 Hz. Every composite still samples animations at the current
# time, so nothing drifts; any other reason to composite (scroll, rendering
# update, video) is unaffected and runs at full rate; a layer that animates
# onto the surface is picked up at the next tick or by the look-ahead.
#
# Covers both compositor back ends: SkiaCompositingLayer (the 2.54 default) and
# TextureMapperLayer (WEBKIT_USE_SKIA_FOR_COMPOSITION=0).
# ATLANTIC_FRAME_TRACE=1 logs "web anim-offscreen" when a wait starts.
#
# Verify on device: idle fps on a scrolled Wikipedia article, and that a
# visible spinner / CSS transition still runs at full rate.
#
# ---
diff --git a/Source/WebCore/platform/graphics/skia/SkiaCompositingLayer.cpp b/Source/WebCore/platform/graphics/skia/SkiaCompositingLayer.cpp
--- a/Source/WebCore/platform/graphics/skia/SkiaCompositingLayer.cpp
+++ b/Source/WebCore/platform/graphics/skia/SkiaCompositingLayer.cpp
@@ -480,6 +480,47 @@ std::optional<SkiaCompositingLayer::AnimationsState> SkiaCompositingLayer::syncA
     return state;
 }
 
+bool SkiaCompositingLayer::subtreeIntersectsRect(const FloatRect& surfaceRect) const
+{
+    // An empty layer that clips shows nothing of its subtree.
+    if (m_rect.isEmpty() && m_masksToBounds)
+        return false;
+
+    // The future transform (where an animation puts the layer ~50 ms from now)
+    // counts too, so a layer flying in is caught before it arrives.
+    auto paintedRect = paintedLayerRect();
+    if (!paintedRect.isEmpty()
+        && (m_transforms.combined.mapRect(paintedRect).intersects(surfaceRect) || m_transforms.futureCombined.mapRect(paintedRect).intersects(surfaceRect)))
+        return true;
+
+    for (auto& child : m_children) {
+        if (child->subtreeIntersectsRect(surfaceRect))
+            return true;
+    }
+    return false;
+}
+
+bool SkiaCompositingLayer::runningAnimationsIntersectRect(const FloatRect& surfaceRect) const
+{
+    bool isAnimated = (m_animationsState && m_animationsState->isRunning)
+        || (m_mask && m_mask->m_animationsState && m_mask->m_animationsState->isRunning);
+    if (isAnimated) {
+        // A replica draws the layer a second time somewhere else; do not try to
+        // work out where.
+        if (m_replica || subtreeIntersectsRect(surfaceRect))
+            return true;
+    }
+
+    if (m_replica && m_replica->runningAnimationsIntersectRect(surfaceRect))
+        return true;
+
+    for (auto& child : m_children) {
+        if (child->runningAnimationsIntersectRect(surfaceRect))
+            return true;
+    }
+    return false;
+}
