+// Low-resolution tiles during scroll. While flinging, freshly-exposed tiles are
+// rasterized into a buffer scaled down by this factor and bilinear-upscaled back to
+// their full on-screen rect at composite time (the eye doesn't resolve detail
+// mid-fling; this is the Chrome/Android "low-res tiles" idea). Raster + fill cost is
+// quadratic in scale, so 0.3x is ~11x cheaper per painted pixel -- the lever that
+// directly cuts the per-frame GPU/raster cost on the serialized compositor-thread
+// paint path. Once the fling settles the tiles are repainted full-res (sharpen at
+// rest). WEBKIT_LOWRES_TILE_SCALE in [0.25, 1.0); **default 0.3 (ON)** when unset.
+// To disable, set it to 1.0 (or any value >=1.0). Fling detection uses the scroll-
+// speed ladder below.
+static float lowResTileScaleDuringScroll()
+{
+    static float scale = [] {
+        if (const char* env = getenv("WEBKIT_LOWRES_TILE_SCALE")) {
+            float value = atof(env);
+            if (value >= 0.25f && value < 1.0f)
+                return value;
+            // Explicitly set but out of the low-res range (e.g. 1.0) => disabled.
+            return 1.0f;
+        }
+        // Unset => default ON at 0.3.
+        return 0.3f;
+    }();
+    return scale;
+}
+
+static bool lowResTilesEnabled()
+{
+    return lowResTileScaleDuringScroll() < 1.0f;
+}
+
