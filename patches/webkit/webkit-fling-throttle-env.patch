+// Fling-throttle (WEBKIT_FLING_THROTTLE_MS, see LayerTreeHost): while the user is
+// fast-flinging, the main thread's rendering updates are capped so scroll-triggered
+// JS/style/layout can't serialize behind the compositor-thread scroll. These knobs
+// tune the fling detector that drives that gate. WEBKIT_FLING_THROTTLE_SPEED is the
+// scroll velocity (CSS px/s) above which a fling is considered active (default 400);
+// WEBKIT_FLING_THROTTLE_SETTLE_MS keeps the throttle armed this long after the last
+// fast motion so a whole flick sequence degrades as one (default 300).
+static float flingThrottleSpeedThreshold()
+{
+    static float threshold = [] {
+        if (const char* env = getenv("WEBKIT_FLING_THROTTLE_SPEED")) {
+            float value = atof(env);
+            if (value >= 50.0f && value <= 20000.0f)
+                return value;
+        }
+        return 400.0f;
+    }();
+    return threshold;
+}
+
+static double flingThrottleSettleMs()
+{
+    static double ms = [] {
+        if (const char* env = getenv("WEBKIT_FLING_THROTTLE_SETTLE_MS")) {
+            double v = atof(env);
+            if (v >= 0 && v <= 2000)
+                return v;
+        }
+        return 300.0;
+    }();
+    return ms;
+}
+
+static bool flingThrottleEnabled()
+{
+    static bool enabled = [] {
+        const char* env = getenv("WEBKIT_FLING_THROTTLE_MS");
+        return env && atof(env) > 0;
+    }();
+    return enabled;
+}
+
+void ScrollingTree::noteScrollForFlingThrottle(ScrollingTreeScrollingNode& node)
+{
+    auto now = MonotonicTime::now();
+    auto position = node.currentScrollPosition();
+
+    Locker locker { m_flingThrottleSampleLock };
+    if (m_flingThrottleSampleNodeID != node.scrollingNodeID()) {
+        // Single sample slot: velocity is only meaningful within one node's motion,
+        // and the frame node dominates any real fling.
+        m_flingThrottleSampleNodeID = node.scrollingNodeID();
+        m_flingThrottleSamplePosition = position;
+        m_flingThrottleSampleTime = now;
+        return;
+    }
+
+    double dtSeconds = (now - m_flingThrottleSampleTime).seconds();
+    float distance = std::max(std::abs(position.x() - m_flingThrottleSamplePosition.x()), std::abs(position.y() - m_flingThrottleSamplePosition.y()));
+    m_flingThrottleSamplePosition = position;
+    m_flingThrottleSampleTime = now;
+
+    // A fast-enough motion (re)arms the fling window; stale samples (> 200ms apart)
+    // don't count as continuous motion.
+    if (dtSeconds > 0 && dtSeconds < 0.2 && distance / dtSeconds > flingThrottleSpeedThreshold()) {
+        auto until = now + Seconds::fromMilliseconds(flingThrottleSettleMs());
+        m_flingThrottleActiveUntilSeconds.store(until.secondsSinceEpoch().seconds(), std::memory_order_relaxed);
+    }
+}
+
+bool ScrollingTree::flingThrottleActive() const
+{
+    double until = m_flingThrottleActiveUntilSeconds.load(std::memory_order_relaxed);
+    return until > 0 && MonotonicTime::now().secondsSinceEpoch().seconds() < until;
+}
+
 void ScrollingTree::scrollingTreeNodeDidScroll(ScrollingTreeScrollingNode& node, ScrollingLayerPositionAction)
 {
+    if (flingThrottleEnabled())
+        noteScrollForFlingThrottle(node);
+
     if (node.isRootNode())
         setMainFrameScrollPosition(node.currentScrollPosition());
 }
