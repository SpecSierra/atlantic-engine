+bool LayerTreeHost::isFlingActiveForThrottle() const
+{
+#if ENABLE(SCROLLING_THREAD)
+    if (auto* scrollingCoordinator = m_webPage.corePage()->scrollingCoordinator()) {
+        if (is<AsyncScrollingCoordinator>(*scrollingCoordinator)) {
+            if (RefPtr scrollingTree = downcast<AsyncScrollingCoordinator>(*scrollingCoordinator).scrollingTree())
+                return scrollingTree->flingThrottleActive();
+        }
+    }
+#endif
+    return false;
+}
+
+void LayerTreeHost::flingThrottleWakeupTimerFired()
+{
+    // The timer's only job is to wake a quiet run loop so the (still-scheduled)
+    // repeating RenderingUpdate observer fires at BeforeWaiting and delivers the
+    // deferred update once the throttle interval has elapsed.
+    scheduleRenderingUpdateRunLoopObserver();
+}
+
 void LayerTreeHost::renderingUpdateRunLoopObserverFired()
 {
     WTFEmitSignpost(this, RenderingUpdateRunLoopObserverFired, "isWaitingForRenderer %s", m_isWaitingForRenderer ? "yes" : "no");
@@ -278,6 +335,20 @@
     if (m_isWaitingForRenderer)
         return;
 
+    if (double intervalMs = flingThrottleIntervalMs()) {
+        auto interval = Seconds::fromMilliseconds(intervalMs);
+        auto elapsed = MonotonicTime::now() - m_lastRenderingUpdateTimeForFlingThrottle;
+        if (elapsed < interval && isFlingActiveForThrottle()) {
+            // Throttled: leave the observer scheduled (it keeps polling every loop
+            // iteration) and make sure a quiet loop wakes up for the remainder.
+            if (!m_flingThrottleWakeupTimer)
+                m_flingThrottleWakeupTimer = makeUnique<RunLoop::Timer>(RunLoop::mainSingleton(), "LayerTreeHost::FlingThrottleWakeup"_s, this, &LayerTreeHost::flingThrottleWakeupTimerFired);
+            if (!m_flingThrottleWakeupTimer->isActive())
+                m_flingThrottleWakeupTimer->startOneShot(interval - elapsed);
+            return;
+        }
+    }
+
     updateRendering();
 }
 
