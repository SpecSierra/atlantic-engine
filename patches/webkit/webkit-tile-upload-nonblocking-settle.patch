+// WEBKIT_TILE_UPLOAD_REST_BUDGET_MB (default 16, 0 = unlimited): the byte
+// budget for settled (non-scrolling) composites. An UNLIMITED settled drain is
+// what froze franceinfo scrolling (device-measured, build 509): every gap
+// between gestures longer than SETTLE_MS flipped the next composite to an
+// unmetered drain that pushed the whole queued batch (tens of MB, DPR3 CPU
+// tiles) through glTexSubImage in one frame — mean scroll FPS 2.0 unlimited vs
+// 7.4 metered. A rest budget a few times the scroll budget keeps post-scroll
+// fill-in completing in one or two big directional waves (the anti-popping
+// behavior the scroll gate exists for) while bounding any single composite.
+static size_t restBudgetBytes()
+{
+    static const size_t bytes = []() -> size_t {
+        if (const char* env = getenv("WEBKIT_TILE_UPLOAD_REST_BUDGET_MB")) {
+            double mb = atof(env);
+            if (mb >= 0 && mb <= 512)
+                return static_cast<size_t>(mb * 1024 * 1024);
+        }
+        return 16 * 1024 * 1024;
+    }();
+    return bytes;
+}
+
+static size_t s_frameBudgetBytes = 0;
+
 bool enabled()
 {
     return !!budgetBytes();
