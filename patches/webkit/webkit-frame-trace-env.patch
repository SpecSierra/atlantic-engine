+    static const bool on = [] {
+        const char* e = getenv("ATLANTIC_FRAME_TRACE");
+        return e && e[0] && e[0] != '0';
+    }();
+    if (!on)
+        return;
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    fprintf(stderr, "[ftrace] web scrollapply thr=%c t=%.1f\n", scrollingThread ? 'S' : 'M', ts.tv_sec * 1000.0 + ts.tv_nsec / 1.0e6);
