+// ATLANTIC_FRAME_TRACE=1 marker (see webkit-frame-trace-env.patch). Same
+// CLOCK_MONOTONIC clock as the ThreadedCompositor and qt5-plugin markers.
+static bool atlFrameTrace()
+{
+    static const bool on = [] {
+        const char* e = getenv("ATLANTIC_FRAME_TRACE");
+        return e && e[0] && e[0] != '0';
+    }();
+    return on;
+}
+static void atlFtrace(const char* what, int w = -1)
+{
+    if (!atlFrameTrace())
+        return;
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    double ms = ts.tv_sec * 1000.0 + ts.tv_nsec / 1.0e6;
+    if (w < 0)
+        fprintf(stderr, "[ftrace] web %s t=%.1f\n", what, ms);
+    else
+        fprintf(stderr, "[ftrace] web %s w=%d t=%.1f\n", what, w, ms);
+}
