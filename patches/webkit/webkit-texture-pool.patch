+// On drivers with unreliable cross-context synchronization (libhybris
+// Adreno), reusing a pooled texture lets a painting context write into a
+// texture the compositor may still have in-flight GPU reads on, flashing
+// stale/foreign content. With WEBKIT_BITMAP_TEXTURE_POOL_DISABLED=1 every
+// acquisition creates a fresh GL texture; the old one is deleted when
+// released and the driver defers actual deletion until pending reads finish.
+static bool texturePoolReuseDisabled()
+{
+    static bool disabled = [] {
+        const char* env = getenv("WEBKIT_BITMAP_TEXTURE_POOL_DISABLED");
+        return env && *env && strcmp(env, "0");
+    }();
+    return disabled;
+}
+
+// The pool's unused-texture release runs on a WebProcess MAIN-THREAD timer.
+// Exactly when texture churn peaks (video playback: one ~9 MB BGRA frame
+// texture per composited frame; page load / scroll: tile-texture churn), the
+// main thread is saturated for seconds to minutes, the timer starves, and
+// released textures accumulate without bound (device-measured: 147 live 1080p
+// frame textures = 1.27 GB in one WebProcess; the phone swap-thrashes and the
+// system OOMs). The compile-time cap (BITMAP_TEXTURE_POOL_MAX_SIZE_IN_MB) is
+// ineffective because it only shortens that same starved timer's interval.
+//
+// Fix: enforce the cap synchronously in acquireTexture(), which always runs
+// on the compositor thread with a GL context current (see the ASSERT), so
+// deletion can never be blocked by main-thread starvation. The cap applies to
+// FREE entries only (refCount == 1): in-use textures are the page's working
+// set, not pool overhead, and counting them would permanently defeat reuse on
+// tile-heavy pages. WEBKIT_TEXTURE_POOL_CAP_MB overrides the compile-time cap
+// (0 = disable synchronous enforcement, stock behaviour, for A/B).
+// WEBKIT_TEXPOOL_LOG=1 logs pool stats on each enforcement.
+static size_t texturePoolFreeCapInBytes()
+{
+    static size_t capBytes = []() -> size_t {
+        if (const char* env = getenv("WEBKIT_TEXTURE_POOL_CAP_MB")) {
+            if (*env)
+                return static_cast<size_t>(strtoul(env, nullptr, 10)) * MB;
+        }
+        return s_poolSizeLimitInBytes;
+    }();
+    return capBytes;
+}
+
+static bool texturePoolLogEnabled()
+{
+    static bool enabled = [] {
+        const char* env = getenv("WEBKIT_TEXPOOL_LOG");
+        return env && *env && strcmp(env, "0");
+    }();
+    return enabled;
+}
+
+void BitmapTexturePool::enforceFreePoolCapWhileLocked()
+{
+    ASSERT(m_lock.isHeld());
+    size_t capBytes = texturePoolFreeCapInBytes();
+    if (!capBytes || capBytes == std::numeric_limits<size_t>::max())
+        return;
+
+    // Total size is an upper bound for the free size: cheap early out.
+    if (m_poolSizeInBytes <= capBytes)
+        return;
+
+    size_t freeBytes = 0;
+    unsigned freeCount = 0;
+    for (const auto& entry : m_textures) {
+        if (entry.texture->refCount() == 1) {
+            freeBytes += entry.texture->sizeInBytes();
+            freeCount++;
+        }
+    }
+
+    if (texturePoolLogEnabled()) {
+        WTFLogAlways("[texpool] entries=%zu total=%zuMB free=%zuMB(%u) cap=%zuMB",
+            m_textures.size(), static_cast<size_t>(m_poolSizeInBytes / MB), freeBytes / MB, freeCount, capBytes / MB);
+    }
+
+    if (freeBytes <= capBytes)
+        return;
+
+    // Keep textures released within the tolerance window so steady-state
+    // producers (the video frame ping-pong, CSS-filter scratch surfaces,
+    // scroll tile reuse) keep reusing instead of churning GL allocations —
+    // churned (created+deleted) textures permanently leak their storage on
+    // the libhybris Adreno driver. Even when the backlog is runaway (> 2x
+    // cap) keep a window above the loaded compositor frame interval, only
+    // shorter than the base tolerance. Entries are in insertion order, so
+    // this releases oldest-first.
+    Seconds tolerance = freeBytes > 2 * capBytes ? Seconds(0.3) : s_releaseUnusedSecondsToleranceOnLimitExceeded;
+    MonotonicTime minUsedTime = MonotonicTime::now() - tolerance;
+    m_textures.removeAllMatching([&](const Entry& entry) {
+        if (freeBytes <= capBytes)
+            return false;
+        if (entry.canBeReleased(minUsedTime)) {
+            size_t bytes = entry.texture->sizeInBytes();
+            freeBytes -= bytes;
+            m_poolSizeInBytes -= bytes;
+            return true;
+        }
+        return false;
+    });
+
+    exitLimitExceededModeIfNeeded();
+}
+
+#if USE(GBM)
+// Image textures (EGLImage imports: the dmabuf/gralloc video-frame path on
+// hybris — CoordinatedPlatformLayerBufferDMABuf::importDMABuf) are appended
+// here once per decoded frame and are ONLY swept by the main-thread timer, so
+// they accumulate the same way under main-thread starvation (device-measured:
+// 149 x ~9 MB frame imports = 1.28 GB kgsl in one WebProcess while the pool's
+// m_textures held just 146 MB). Unlike pooled textures they have zero reuse
+// value — each wraps one specific frame's EGLImage — so sweep every released
+// (refCount == 1) entry synchronously whenever the pool is entered on the
+// compositor thread. In-flight frames (committed/pending buffers) hold a ref
+// and are never touched.
+void BitmapTexturePool::releaseUnusedImageTexturesWhileLocked()
+{
+    ASSERT(m_lock.isHeld());
+    if (m_imageTextures.isEmpty())
+        return;
+
+    auto sizeBefore = m_imageTextures.size();
+    m_imageTextures.removeAllMatching([](const BitmapTexture& texture) {
+        return texture.refCount() == 1;
+    });
+
+    if (texturePoolLogEnabled() && m_imageTextures.size() != sizeBefore)
+        WTFLogAlways("[texpool] image textures: %zu -> %zu", sizeBefore, m_imageTextures.size());
+}
+#endif
