+// Whether the first scroll event of a gesture rebases the scroll origin to the current
+// touch point, discarding drift accumulated during the preceding hold so it cannot charge
+// the kinetic fling. See webkit-touch-axis-rebase-on-scroll-start.patch.
+// WEBKIT_TOUCH_AXIS_REBASE=0 restores stock behaviour.
+static bool touchAxisRebaseEnabled()
+{
+    static bool enabled = [] {
+        const char* v = getenv("WEBKIT_TOUCH_AXIS_REBASE");
+        return !v || (*v && *v != '0');
+    }();
+    return enabled;
