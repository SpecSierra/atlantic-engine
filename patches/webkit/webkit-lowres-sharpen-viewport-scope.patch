+// Scope of the sharpen-at-rest pass.
+//
+// When degradation ends, every tile still at low resolution is invalidated WHOLE
+// and repainted at full resolution. That includes the prepaint cushion -- with the
+// default cover multiplier of 2, roughly half the tiles held are outside the
+// viewport and were never looked at. The repaint lands precisely when the user has
+// just stopped scrolling, so it is felt as a stutter at rest.
+//
+// This is also the fixed cost that makes marginal engagement a losing trade, and it
+// is measured, not assumed: halving how often the tier armed changed the cheap-page
+// penalty by nothing at all, and a barely-degraded 0.90 scale still paid the entire
+// +1.9pp jank penalty. The cost is per ENGAGEMENT, not per unit of degradation,
+// because each engagement ends in one of these full repaints.
+//
+// With WEBKIT_LOWRES_SHARPEN_VIEWPORT_ONLY=1 only tiles intersecting the viewport
+// (inflated by WEBKIT_LOWRES_SHARPEN_MARGIN_PX) are sharpened at rest. Cushion tiles
+// stay soft and sharpen later, when the viewport actually reaches them -- this same
+// pass runs on every non-degrading update, so a tile entering the margin is
+// sharpened before it is visible. Nothing is left permanently soft on screen.
+//
+// Default OFF pending the on-device A/B. Note this helps the legacy speed ladder
+// exactly as much as the cost trigger: the sharpen pass is shared by both.
+static bool sharpenViewportOnly()
+{
+    static bool enabled = [] {
+        // Unset => ON. Measured on build 626: 531 tiles sharpened vs 2172 deferred
+        // (80% of the repaint avoided), fps +6%, p95 -3%/-11%, raster CPU -7%/-5%
+        // on heavy/multilayer, non-overlapping spreads. Device-validated.
+        // "0" restores the whole-cushion repaint.
+        const char* env = getenv("WEBKIT_LOWRES_SHARPEN_VIEWPORT_ONLY");
+        if (!env || !*env)
+            return true;
+        return strcmp(env, "0") != 0;
+    }();
+    return enabled;
+}
+
+// How far beyond the viewport to sharpen, so a tile is crisp BEFORE it scrolls into
+// view rather than in the frame it becomes visible. Roughly one tile row by default.
+// WEBKIT_LOWRES_SHARPEN_MARGIN_PX, default 512.
+static int sharpenMarginPx()
+{
+    static int px = [] {
+        if (const char* env = getenv("WEBKIT_LOWRES_SHARPEN_MARGIN_PX")) {
+            int v = atoi(env);
+            if (v >= 0 && v <= 8192)
+                return v;
+        }
+        return 512;
+    }();
+    return px;
+}
+
